--// ========== Syntax highlighter Luau ==========
local function hex(c)
	return string.format(
		"#%02x%02x%02x",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end
local SYN = {
	kw = hex(Color3.fromRGB(178, 140, 255)),
	bi = hex(Color3.fromRGB(126, 184, 236)),
	str = hex(Color3.fromRGB(152, 208, 142)),
	num = hex(Color3.fromRGB(236, 168, 108)),
	cm = hex(Color3.fromRGB(98, 98, 116)),
	fn = hex(Color3.fromRGB(226, 206, 142)),
}

local function set(list)
	local t = {}
	for _, v in ipairs(list) do
		t[v] = true
	end
	return t
end

local KEYWORDS = set({
	"and", "break", "continue", "do", "else", "elseif", "end", "false", "for", "function", "if", "in",
	"local", "nil", "not", "or", "repeat", "return", "then", "true", "until", "while",
})
local BUILTINS = set({
	"print", "warn", "error", "assert", "pcall", "xpcall", "pairs", "ipairs", "next", "select", "tostring",
	"tonumber", "type", "typeof", "rawget", "rawset", "rawequal", "rawlen", "setmetatable", "getmetatable",
	"require", "loadstring", "tick", "time", "wait", "spawn", "delay", "task", "game", "workspace", "script",
	"math", "string", "table", "os", "coroutine", "bit32", "utf8", "debug", "Instance", "Vector2", "Vector3",
	"CFrame", "Color3", "UDim", "UDim2", "Enum", "Ray", "Random", "TweenInfo", "BrickColor", "NumberRange",
	"NumberSequence", "ColorSequence", "Rect", "Region3", "Axes", "Faces", "shared", "_G", "_VERSION", "self",
	"getgenv", "getrenv", "getfenv", "setfenv", "unpack", "newproxy", "collectgarbage",
})

local function esc(s)
	return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;"))
end

-- hasil: array per baris (string rich text)
local function highlight(src)
	local lines, buf = {}, {}
	local function emit(str, color)
		local start = 1
		while true do
			local nl = str:find("\n", start, true)
			local seg = str:sub(start, nl and nl - 1 or #str)
			if #seg > 0 then
				if color then
					buf[#buf + 1] = '<font color="' .. color .. '">' .. esc(seg) .. "</font>"
				else
					buf[#buf + 1] = esc(seg)
				end
			end
			if not nl then
				break
			end
			lines[#lines + 1] = table.concat(buf)
			buf = {}
			start = nl + 1
		end
	end

	local i, n = 1, #src
	while i <= n do
		local c = src:sub(i, i)
		if c == "-" and src:sub(i + 1, i + 1) == "-" then
			local eq = src:match("^%-%-%[(=*)%[", i)
			local e
			if eq then
				local _, ce = src:find("]" .. eq .. "]", i + #eq + 4, true)
				e = ce or n
			else
				local nl = src:find("\n", i, true)
				e = nl and nl - 1 or n
			end
			emit(src:sub(i, e), SYN.cm)
			i = e + 1
		elseif c == '"' or c == "'" or c == "`" then
			local j, e = i + 1, nil
			while j <= n do
				local d = src:sub(j, j)
				if d == "\\" then
					j += 2
				elseif d == c then
					e = j
					break
				elseif d == "\n" and c ~= "`" then
					e = j - 1
					break
				else
					j += 1
				end
			end
			e = math.min(e or n, n)
			emit(src:sub(i, e), SYN.str)
			i = e + 1
		elseif c == "[" then
			local eq = src:match("^%[(=*)%[", i)
			if eq then
				local _, ce = src:find("]" .. eq .. "]", i + #eq + 2, true)
				local e = ce or n
				emit(src:sub(i, e), SYN.str)
				i = e + 1
			else
				emit(c)
				i += 1
			end
		elseif c:find("%d") or (c == "." and src:find("^%.%d", i)) then
			local s2, e2 = src:find("^0[xX][%x_]+", i)
			if not s2 then
				s2, e2 = src:find("^0[bB][01_]+", i)
			end
			if not s2 then
				s2, e2 = src:find("^%d[%d_]*%.?[%d_]*", i)
				if not s2 then
					s2, e2 = src:find("^%.%d[%d_]*", i)
				end
				if src:sub(e2, e2) == "." and src:sub(e2 + 1, e2 + 1) == "." then
					e2 -= 1
				end
				local _, ee = src:find("^[eE][+-]?%d+", e2 + 1)
				if ee then
					e2 = ee
				end
			end
			emit(src:sub(i, e2), SYN.num)
			i = e2 + 1
		elseif c:find("[%a_]") then
			local _, e2 = src:find("^[%a_][%w_]*", i)
			local word = src:sub(i, e2)
			local prevc = i > 1 and src:sub(i - 1, i - 1) or ""
			local color
			if prevc == "." or prevc == ":" then
				if src:find("^%s*%(", e2 + 1) then
					color = SYN.fn
				end
			elseif KEYWORDS[word] then
				color = SYN.kw
			elseif BUILTINS[word] then
				color = SYN.bi
			elseif src:find("^%s*%(", e2 + 1) then
				color = SYN.fn
			end
			emit(word, color)
			i = e2 + 1
		else
			local s2, e2 = src:find("^[^%w_\"'`%-%[]+", i)
			if s2 then
				emit(src:sub(s2, e2))
				i = e2 + 1
			else
				emit(c)
				i += 1
			end
		end
	end
	lines[#lines + 1] = table.concat(buf)
	return lines
end

local lineH = TextService:GetTextSize("A", 13, Enum.Font.Code, Vector2.new(1e4, 1e4)).Y
local MAX_HL = 100000
local hlLines, hlOn = nil, true
local wFirst, wLast = -1, -1

local function renderWindow(force)
	if not hlOn or not hlLines then
		return
	end
	local y = editorScroll.CanvasPosition.Y
	local first = math.max(1, math.floor(y / lineH) - 15)
	first = math.min(first, #hlLines)
	local last = math.min(#hlLines, first + math.ceil(240 / lineH) + 40)
	if not force and first == wFirst and last == wLast then
		return
	end
	wFirst, wLast = first, last
	hlLabel.Position = UDim2.fromOffset(8, 8 + (first - 1) * lineH)
	hlLabel.Text = table.concat(hlLines, "\n", first, last)
end

local function retokenize()
	local text = editor.Text:gsub("\r", "")
	if #text > MAX_HL then
		hlOn = false
		hlLines = nil
		editor.TextTransparency = 0
		hlLabel.Visible = false
		return
	end
	hlOn = true
	editor.TextTransparency = 1
	hlLabel.Visible = true
	hlLines = highlight(text)
	renderWindow(true)
end

local hlQueued = false
local function queueHighlight()
	if hlQueued then
		return
	end
	hlQueued = true
	task.defer(function()
		hlQueued = false
		retokenize()
	end)
end

local function updateGutter()
	local n = 1
	for _ in editor.Text:gmatch("\n") do
		n += 1
	end
	n = math.min(n, 5000)
	local t = table.create(n)
	for i = 1, n do
		t[i] = tostring(i)
	end
	gutterLabel.Text = table.concat(t, "\n")
end

editorScroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
	gutterLabel.Position = UDim2.fromOffset(0, 8 - editorScroll.CanvasPosition.Y)
	renderWindow(false)
end)

