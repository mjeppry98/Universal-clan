local function httpGet(url)
	local ok, res = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(res) == "string" and #res > 0 then
		return res
	end
	ok, res = pcall(function()
		return game:HttpGet(url, true)
	end)
	if ok and type(res) == "string" and #res > 0 then
		return res
	end
	if REQ then
		local ok2, r = pcall(REQ, { Url = url, Method = "GET" })
		if ok2 and type(r) == "table" and (r.StatusCode == 200 or r.Success == true) and type(r.Body) == "string" then
			return r.Body
		end
	end
	local ok3, res3 = pcall(function()
		return HttpService:GetAsync(url)
	end)
	if ok3 and type(res3) == "string" and #res3 > 0 then
		return res3
	end
	return nil
end

local function executorInfo()
	local ok, n, v = pcall(function()
		if identifyexecutor then
			return identifyexecutor()
		end
		if getexecutorname then
			return getexecutorname()
		end
		return nil
	end)
	if ok and n then
		return tostring(n), v and tostring(v) or nil
	end
	return "Unknown", nil
end

--// ========== Hapus instance lama + mount ==========
local function eachHost(fn)
	local hosts = {}
	local okh, h = pcall(function()
		local g = gethui or get_hidden_gui
		return g and g()
	end)
	if okh and h then
		hosts[#hosts + 1] = h
	end
	local okc, cg = pcall(function()
		return game:GetService("CoreGui")
	end)
	if okc and cg then
		hosts[#hosts + 1] = cg
	end
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	if pg then
		hosts[#hosts + 1] = pg
	end
	for _, x in ipairs(hosts) do
		pcall(fn, x)
	end
end

if ENV.NocturneGui then
	pcall(function()
		ENV.NocturneGui:Destroy()
	end)
end
eachHost(function(h)
	local o = h:FindFirstChild("NocturneExecutor")
	if o then
		o:Destroy()
	end
end)

local function mountGui(g)
	local ok, h = pcall(function()
		local fn = gethui or get_hidden_gui
		return fn and fn()
	end)
	if ok and h then
		g.Parent = h
		return "gethui"
	end
	if syn and syn.protect_gui then
		pcall(syn.protect_gui, g)
	end
	local ok2 = pcall(function()
		g.Parent = game:GetService("CoreGui")
	end)
	if ok2 and g.Parent then
		return "CoreGui"
	end
	g.Parent = lp:WaitForChild("PlayerGui")
	return "PlayerGui"
end

