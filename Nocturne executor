			Parent = card,
		})
	end

	local input
	if spec.input ~= nil then
		input = create("TextBox", {
			Text = spec.input,
			PlaceholderText = spec.placeholder or "",
			PlaceholderColor3 = C.dim,
			ClearTextOnFocus = false,
			TextColor3 = C.text,
			Font = Enum.Font.Gotham,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundColor3 = C.bg,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 32),
			LayoutOrder = lo(),
			Parent = card,
		})
		corner(input, 5)
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = input })
		local st = create("UIStroke", {
			Color = C.line,
			Thickness = 1,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = input,
		})
		input.Focused:Connect(function()
			tw(st, 0.12, { Color = C.accent })
		end)
		input.FocusLost:Connect(function()
			tw(st, 0.12, { Color = C.line })
		end)
	end

	if spec.options then
		local h = math.min(#spec.options * 30, 150)
		local sc = create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, h),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = C.dim,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			LayoutOrder = lo(),
			Parent = card,
		})
		create("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = sc })
