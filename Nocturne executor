local function fmtViews(n)
	n = tonumber(n) or 0
	if n >= 1e6 then
		return ("%.1fM"):format(n / 1e6)
	elseif n >= 1e3 then
		return ("%.1fk"):format(n / 1e3)
	end
	return tostring(math.floor(n))
end

--// Ambil kode (dari hasil search, atau /script/raw/<id>)
local function sbGetCode(item, cb)
	if type(item.script) == "string" and #item.script > 0 then
		cb(item.script)
		return
	end
	setStatus("Mengambil kode...", C.sub)
	task.spawn(function()
		local raw = httpGet(API .. "/script/raw/" .. HttpService:UrlEncode(tostring(item._id)))
		if raw and #raw > 0 and not raw:match('^%s*{%s*"') then
			cb(raw)
		else
			setStatus("Gagal mengambil kode script", C.err)
			log("gagal mengambil kode untuk " .. tostring(item.title), "err")
		end
	end)
end

local function sbTitle(item)
	local t = tostring(item.title or "Script")
	t = t:gsub("%c", " ")
	t = t:match("^%s*(.-)%s*$"):sub(1, 28)
	if t == "" then
		t = "Script"
	end
	return t
end

local function sbSave(item, open)
	sbGetCode(item, function(code)
		local s = addScript(uniqueName(sbTitle(item), "", nil), "", code)
		persist()
		if open then
			openScript(s.id)
			switchTab("Editor")
			setStatus("Dimuat ke editor: " .. s.name, C.ok)
		else
			refreshLibrary()
			setStatus("Disimpan ke library: " .. s.name, C.ok)
		end
	end)
end

local function sbRun(item)
	showDialog({
		title = "Jalankan script?",
		message = "Kode ini berasal dari pihak ketiga dan belum lu periksa. Lebih aman pakai Load dulu, baca isinya di editor, baru Execute.",
		ok = "Jalankan",
		danger = true,
		onSubmit = function()
			sbGetCode(item, function(code)
				runSource(code, sbTitle(item))
			end)
		end,
	})
end

