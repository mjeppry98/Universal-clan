sbLoad = function(mode, query, page, append)
	if sb.loading then
		setStatus("ScriptBlox masih memuat...", C.sub)
		return
	end
	sb.loading = true
	sbBusy(true)
	if not append then
		clearSb()
		sb.items = {}
		sbMessage("Memuat...", C.sub)
	end
	task.spawn(function()
		local wait_ = 0.8 - (os.clock() - sb.last)
		if wait_ > 0 then
			task.wait(wait_)
		end
		local result, err = sbRequest(mode, query, page)
		sb.last = os.clock()
		sb.loading = false
		sbBusy(false)
		if not result then
			if not append then
				clearSb()
			end
			sbMessage(err, C.err)
			setStatus(err, C.err)
			log("scriptblox: " .. tostring(err), "err")
			return
		end
		local list = result.scripts or {}
		if not append then
			clearSb()
		else
			if sbMore then
				sbMore:Destroy()
				sbMore = nil
			end
		end
		sb.mode, sb.query, sb.page = mode, query, page
		sb.total = (mode == "trending") and 1 or (tonumber(result.totalPages) or page)
		for _, it in ipairs(list) do
			if type(it) == "table" then
				table.insert(sb.items, it)
				sbAddRow(it)
			end
		end
		if #sb.items == 0 then
			sbMessage("Tidak ada hasil.", C.sub)
		end
		sbSetMore()
		setStatus(("ScriptBlox: %d script dimuat"):format(#sb.items), C.sub)
	end)
end

