			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1),
			{ Position = UDim2.fromScale(1, 0) }
		)
		sbBarTween:Play()
	else
		sbBar.Visible = false
	end
end

