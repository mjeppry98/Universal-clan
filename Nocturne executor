local lastPath = "script.lua"

local function runFromUrl()
	showDialog({
		title = "Jalankan dari URL",
		message = "Mengunduh kode dari URL lalu menjalankannya dengan loadstring.",
		input = "https://",
		ok = "Jalankan",
		onSubmit = function(v)
			v = (v or ""):match("^%s*(.-)%s*$")
			if not v:match("^https?://") then
				return "URL harus diawali http:// atau https://"
			end
			task.spawn(function()
				setStatus("Mengunduh script...", C.sub)
				local code = httpGet(v)
				if not code then
					setStatus("Gagal mengunduh script", C.err)
					log("gagal mengunduh " .. v, "err")
					return
				end
				runSource(code, v)
			end)
		end,
	})
end

local function runFromFile(loadOnly)
	if not (readfile and isfile) then
		setStatus("readfile tidak tersedia di executor ini", C.warn)
		return
	end
	showDialog({
		title = loadOnly and "Muat file ke editor" or "Jalankan file",
		message = "Path relatif ke folder workspace executor.",
		input = lastPath,
		placeholder = "contoh: script.lua",
		ok = loadOnly and "Muat" or "Jalankan",
		onSubmit = function(v)
			v = (v or ""):match("^%s*(.-)%s*$")
			if v == "" then
				return "Path tidak boleh kosong"
			end
			local okf, exists = pcall(isfile, v)
			if not (okf and exists) then
				return "File tidak ditemukan"
			end
			local okr, content = pcall(readfile, v)
			if not okr or type(content) ~= "string" then
				return "Gagal membaca file"
			end
			lastPath = v
			if loadOnly then
				local nm = v:match("([^/\\]+)$") or v
				nm = nm:gsub("%.[%w]+$", "")
				nm = nm:sub(1, 28)
				if nm == "" then
					nm = "File"
				end
				local s = addScript(uniqueName(nm, "", nil), "", content)
				persist()
				openScript(s.id)
				setStatus("Dimuat: " .. s.name, C.ok)
			else
				runSource(content, v)
			end
		end,
	})
end

local function pasteClipboard()
	if not getClip then
		setStatus("Executor ini tidak punya fungsi baca clipboard", C.warn)
