local entries, logCount = {}, 0
local function log(msg, kind)
	local col, tag = C.text, "info"
	if kind == "err" then
		col, tag = C.err, "error"
	elseif kind == "ok" then
		col, tag = C.ok, "ok"
	elseif kind == "warn" then
		col, tag = C.warn, "warn"
	end
	logCount += 1
	local l = create("TextLabel", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		TextWrapped = true,
