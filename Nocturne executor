--// ========== Eksekusi ==========
local function runSource(src, label)
	if type(src) ~= "string" or src:gsub("%s", "") == "" then
		setStatus("Tidak ada script untuk dijalankan", C.err)
		log("tidak ada script untuk dijalankan", "err")
		return
	end
	if not LS then
		setStatus("Executor ini tidak mendukung loadstring", C.err)
		log("loadstring tidak tersedia/tidak bekerja di environment ini, script tidak bisa dijalankan", "err")
		return
	end
	src = src:gsub("^\239\187\191", "") -- buang BOM UTF-8
	setStatus("Menjalankan...", C.sub)

	local okCall, fn, cerr = pcall(LS, src, label or "Nocturne")
	if not okCall then
		setStatus("Gagal memuat script", C.err)
		log("gagal memuat script: " .. tostring(fn), "err")
		return
	end
	if type(fn) ~= "function" then
		setStatus("Syntax error", C.err)
		log(tostring(cerr), "err")
		return
	end
	task.spawn(function()
		local tb = (debug and debug.traceback) or function(m)
			return tostring(m)
		end
		local ok, e = xpcall(fn, function(m)
			return tb(tostring(m), 2)
		end)
		if ok then
			setStatus("Executed", C.ok)
			log("executed " .. tostring(label or "Nocturne"), "ok")
		else
			setStatus("Runtime error", C.err)
			log(e, "err")
		end
	end)
end

local function execute()
	runSource(editor.Text, "Nocturne")
end

local function saveCurrent()
	local s = byId(activeId)
	if not s then
		-- tidak ada script aktif: simpan isi editor sebagai script baru
		if editor.Text:gsub("%s", "") == "" then
			setStatus("Tidak ada yang disimpan", C.warn)
			return
		end
		s = createScript("")
		s.source = editor.Text
		table.insert(openTabs, s.id)
		activeId = s.id
		live[s.id] = nil
		local ok0 = persist()
		refreshTabs()
		refreshLibrary()
		setStatus(ok0 and ("Saved: " .. s.name) or "Tersimpan di sesi saja", ok0 and C.ok or C.warn)
		return
	end
	s.source = editor.Text
	live[s.id] = nil
	local ok = persist()
	updateDirty()
	if ok then
		setStatus("Saved: " .. s.name, C.ok)
		log("saved " .. s.name, "ok")
	else
		setStatus("Tersimpan di sesi saja (writefile tidak tersedia)", C.warn)
		log("writefile tidak tersedia, script hanya tersimpan selama UI terbuka", "warn")
	end
end

