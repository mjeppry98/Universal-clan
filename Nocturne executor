			c:Destroy()
		end
	end
	tabObjs = {}
	for i, id in ipairs(openTabs) do
		local s = byId(id)
		if s then
			local active = id == activeId
			local w = math.clamp(
				TextService:GetTextSize(s.name, 12, Enum.Font.GothamMedium, Vector2.new(1e4, 26)).X + 52,
				84,
				170
			)
			local b = create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = active and C.bg or C.surface,
				BackgroundTransparency = active and 0 or 1,
				BorderSizePixel = 0,
				Size = UDim2.fromOffset(w, STRIP - 1),
				LayoutOrder = i,
				Parent = strip,
			})
			create("TextLabel", {
				Text = s.name,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = active and C.text or C.sub,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(10, 0),
				Size = UDim2.new(1, -42, 1, 0),
				Parent = b,
			})
			local dot = create("Frame", {
				Size = UDim2.fromOffset(6, 6),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(1, -33, 0.5, 0),
				BackgroundColor3 = C.accent,
				BorderSizePixel = 0,
				Visible = isDirty(id),
				Parent = b,
			})
			corner(dot, 3)
			local x = create("TextButton", {
				Text = "",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -5, 0.5, 0),
				Size = UDim2.fromOffset(20, 20),
				Parent = b,
			})
			local xi = icon(x, "close", 10, UDim2.fromScale(0.5, 0.5), C.sub, "x")
			x.MouseEnter:Connect(function()
				tint(xi, C.text, 0.08)
			end)
			x.MouseLeave:Connect(function()
				tint(xi, C.sub, 0.08)
			end)
			if active then
				local ul = create("Frame", {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.fromScale(0, 1),
					Size = UDim2.new(0, 0, 0, 2),
					BackgroundColor3 = C.accent,
					BorderSizePixel = 0,
					Parent = b,
				})
				tw(ul, 0.2, { Size = UDim2.new(1, 0, 0, 2) })
			else
				b.MouseEnter:Connect(function()
					tw(b, 0.08, { BackgroundTransparency = 0.5 })
				end)
				b.MouseLeave:Connect(function()
					tw(b, 0.08, { BackgroundTransparency = 1 })
				end)
			end
			b.MouseButton1Click:Connect(function()
				if id ~= activeId then
					setActive(id)
				end
			end)
			x.MouseButton1Click:Connect(function()
				closeTab(id)
			end)
			tabObjs[id] = { dot = dot }
		end
	end
end

setActive = function(id)
	local s = byId(id)
	if not s then
		return
	end
	if activeId and activeId ~= id then
		live[activeId] = editor.Text
	end
	activeId = id
	loading = true
	editor.Text = live[id] or s.source
	loading = false
	editorScroll.CanvasPosition = Vector2.new(0, 0)
	refreshTabs()
	refreshLibrary()
end

local function openScript(id)
	if not table.find(openTabs, id) then
		table.insert(openTabs, id)
	end
	setActive(id)
end

local function newScript(folder)
	local s = createScript(folder)
	openScript(s.id)
	persist()
	setStatus("Dibuat: " .. s.name, C.ok)
	return s
end

closeTab = function(id)
	local idx = table.find(openTabs, id)
	if not idx then
		return
	end
	if id == activeId then
		live[id] = editor.Text
	end
	table.remove(openTabs, idx)
	if id == activeId then
		if #openTabs > 0 then
			setActive(openTabs[math.min(idx, #openTabs)])
		else
			showEmpty()
		end
	else
		refreshTabs()
	end
end

--// ----- Aksi script / folder -----
local function renameScript(s)
	showDialog({
		title = "Rename script",
		input = s.name,
		ok = "Simpan",
		onSubmit = function(v)
			local name, e = validName(v)
			if not name then
				return e
			end
			if name ~= s.name and nameTaken(name, s.folder, s.id) then
				return "Nama sudah dipakai di folder ini"
			end
			s.name = name
			persist()
			refreshTabs()
			refreshLibrary()
			setStatus("Rename: " .. name, C.ok)
		end,
	})
end

-- Hapus script: benar-benar hilang dari library, tab, dan file. Tidak membuat script baru.
local function deleteScript(s)
	showDialog({
		title = "Hapus script",
		message = ('Hapus "%s"? Tindakan ini tidak bisa dibatalkan.'):format(s.name),
		ok = "Hapus",
		danger = true,
		onSubmit = function()
			local wasActive = s.id == activeId
			local idx = table.find(openTabs, s.id)
			if idx then
				table.remove(openTabs, idx)
			end
			live[s.id] = nil
			local pos = table.find(store.scripts, s)
			if pos then
				table.remove(store.scripts, pos)
			end
			if wasActive then
				activeId = nil
				if #openTabs > 0 then
					setActive(openTabs[math.min(idx or 1, #openTabs)])
				else
					showEmpty()
				end
			else
				refreshTabs()
				refreshLibrary()
			end
			persist()
			setStatus("Dihapus: " .. s.name, C.sub)
		end,
	})
end

local function moveScript(s)
	local opts = { { label = "(Tanpa folder)", value = "", current = (s.folder or "") == "" } }
	for _, f in ipairs(store.folders) do
		table.insert(opts, { label = f.name, value = f.name, current = s.folder == f.name })
	end
	showDialog({
		title = "Pindah ke folder",
		options = opts,
		onChoose = function(folder)
			if folder == (s.folder or "") then
				return
			end
			if nameTaken(s.name, folder, s.id) then
				s.name = uniqueName(s.name, folder, s.id)
			end
			s.folder = folder
			for _, f in ipairs(store.folders) do
				if f.name == folder then
					f.open = true
				end
			end
			persist()
			refreshTabs()
			refreshLibrary()
			setStatus("Dipindah: " .. s.name, C.ok)
		end,
	})
end

local function newFolder()
	local n = 1
	while folderTaken("Folder " .. n) do
		n += 1
	end
	showDialog({
		title = "Folder baru",
		input = "Folder " .. n,
		ok = "Buat",
		onSubmit = function(v)
			local name, e = validName(v)
			if not name then
				return e
			end
			if folderTaken(name) then
				return "Nama folder sudah ada"
			end
			table.insert(store.folders, { name = name, open = true })
			persist()
			refreshLibrary()
			setStatus("Folder dibuat: " .. name, C.ok)
		end,
	})
end

local function renameFolder(f)
	showDialog({
		title = "Rename folder",
		input = f.name,
		ok = "Simpan",
		onSubmit = function(v)
			local name, e = validName(v)
			if not name then
				return e
			end
			if name ~= f.name and folderTaken(name, f.name) then
				return "Nama folder sudah ada"
			end
			for _, s in ipairs(store.scripts) do
				if s.folder == f.name then
					s.folder = name
				end
			end
			f.name = name
			persist()
			refreshLibrary()
			setStatus("Rename folder: " .. name, C.ok)
		end,
	})
end

local function deleteFolder(f)
	showDialog({
		title = "Hapus folder",
		message = ('Hapus folder "%s"? Script di dalamnya dipindah ke luar folder.'):format(f.name),
		ok = "Hapus",
		danger = true,
		onSubmit = function()
			for _, s in ipairs(store.scripts) do
				if s.folder == f.name then
					s.name = uniqueName(s.name, "", s.id)
					s.folder = ""
				end
			end
			local pos = table.find(store.folders, f)
			if pos then
				table.remove(store.folders, pos)
			end
			persist()
			refreshTabs()
			refreshLibrary()
			setStatus("Folder dihapus", C.sub)
		end,
	})
end

--// ----- Library list -----
refreshLibrary = function()
	for _, c in ipairs(libList:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
	local ord = 0

	local function makeRow(o)
		ord += 1
		local r = create("CanvasGroup", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = C.surface,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			GroupTransparency = 1,
			LayoutOrder = ord,
			Parent = libList,
		})
		corner(r, 5)
		local hit = create("TextButton", {
			Text = "",
			BackgroundTransparency = 1,
			Size = UDim2.fromScale(1, 1),
			Parent = r,
		})
		hit.MouseEnter:Connect(function()
			tw(r, 0.08, { BackgroundTransparency = 0.5 })
		end)
		hit.MouseLeave:Connect(function()
			tw(r, 0.08, { BackgroundTransparency = 1 })
		end)
		hit.MouseButton1Click:Connect(o.onClick)
		icon(r, o.icon, 14, UDim2.fromOffset(16 + o.indent, 15), o.iconColor or C.sub, o.fb)
		local reserve = #o.actions * 28 + 10
		create("TextLabel", {
			Text = o.text,
			Font = Enum.Font.GothamMedium,
			TextSize = 12,
			TextColor3 = o.color or C.text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(34 + o.indent, 0),
			Size = UDim2.new(1, -(34 + o.indent + reserve), 1, 0),
			Parent = r,
		})
		for k, a in ipairs(o.actions) do
			local ab = create("TextButton", {
				Text = "",
				BackgroundTransparency = 1,
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -6 - (k - 1) * 28, 0.5, 0),
				Size = UDim2.fromOffset(26, 26),
				Parent = r,
			})
			local ai = icon(ab, a[1], 13, UDim2.fromScale(0.5, 0.5), C.sub, a[2])
			ab.MouseEnter:Connect(function()
				tint(ai, C.text, 0.08)
			end)
			ab.MouseLeave:Connect(function()
				tint(ai, C.sub, 0.08)
			end)
			ab.MouseButton1Click:Connect(a[3])
		end
		tw(r, 0.15, { GroupTransparency = 0 })
	end

	local function scriptRow(s, indent)
		local active = s.id == activeId
		return {
			indent = indent,
			icon = "file",
			fb = "-",
			iconColor = active and C.accent or C.sub,
			text = s.name,
			color = active and C.accentLight or C.text,
			onClick = function()
				openScript(s.id)
				switchTab("Editor")
			end,
			actions = {
				{ "trash", "x", function() deleteScript(s) end },
				{ "folder", "f", function() moveScript(s) end },
				{ "edit", "r", function() renameScript(s) end },
			},
		}
	end

	if #store.folders == 0 and #store.scripts == 0 then
		create("TextLabel", {
			Text = "Library kosong. Tekan Script untuk membuat yang baru.",
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextColor3 = C.sub,
			TextWrapped = true,
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = 1,
			Parent = libList,
		})
		return
	end

	for _, f in ipairs(store.folders) do
		local count = 0
		for _, s in ipairs(store.scripts) do
			if s.folder == f.name then
				count += 1
			end
		end
		makeRow({
			indent = 0,
			icon = "folder",
			fb = "F",
			iconColor = f.open and C.accent or C.sub,
			text = ("%s  (%d)"):format(f.name, count),
			color = C.text,
			onClick = function()
				f.open = not f.open
				persist()
				refreshLibrary()
			end,
			actions = {
				{ "trash", "x", function() deleteFolder(f) end },
				{ "edit", "r", function() renameFolder(f) end },
			},
		})
		if f.open then
			for _, s in ipairs(store.scripts) do
				if s.folder == f.name then
					makeRow(scriptRow(s, 16))
				end
			end
		end
	end
	for _, s in ipairs(store.scripts) do
		if (s.folder or "") == "" then
			makeRow(scriptRow(s, 0))
		end
	end
end

--// ========== Aksi toolbar ==========
local function runSource(src, label)
	if src:gsub("%s", "") == "" then
		setStatus("Editor kosong", C.err)
		log("editor kosong", "err")
		return
	end
	setStatus("Menjalankan...", C.sub)

	local okCall, fn, cerr = pcall(function()
		return loadstring(src, label or "Nocturne")
	end)
	if not okCall then
		setStatus("loadstring tidak tersedia", C.err)
		log("loadstring tidak tersedia di environment ini: " .. tostring(fn), "err")
		return
	end
	if not fn then
		setStatus("Syntax error", C.err)
		log(tostring(cerr), "err")
		return
	end
	task.spawn(function()
		local ok, e = xpcall(fn, function(m)
			return debug.traceback(tostring(m), 2)
		end)
		if ok then
			setStatus("Executed", C.ok)
			log("executed " .. tostring(label or "Nocturne"), "ok")
		else
			setStatus("Runtime error", C.err)
			log(e, "err")
		end
	end)
end

local function execute()
	runSource(editor.Text, "Nocturne")
end

local function saveCurrent()
	local s = byId(activeId)
	if not s then
		-- tidak ada script aktif: simpan isi editor sebagai script baru
		if editor.Text:gsub("%s", "") == "" then
			setStatus("Tidak ada yang disimpan", C.warn)
			return
		end
		s = createScript("")
		s.source = editor.Text
		table.insert(openTabs, s.id)
		activeId = s.id
		live[s.id] = nil
		local ok0 = persist()
		refreshTabs()
		refreshLibrary()
		setStatus(ok0 and ("Saved: " .. s.name) or "Tersimpan di sesi saja", ok0 and C.ok or C.warn)
		return
	end
	s.source = editor.Text
	live[s.id] = nil
	local ok = persist()
	updateDirty()
	if ok then
		setStatus("Saved: " .. s.name, C.ok)
		log("saved " .. s.name, "ok")
	else
		setStatus("Tersimpan di sesi saja (writefile tidak tersedia)", C.warn)
		log("writefile tidak tersedia, script hanya tersimpan selama UI terbuka", "warn")
	end
end

