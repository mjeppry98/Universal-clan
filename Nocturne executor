--// ========== ScriptBlox ==========
-- API publik: https://scriptblox.com/api  (/script/fetch, /script/search, /script/trending, /script/raw/<id>)
local API = "https://scriptblox.com/api"
local sb = { mode = "latest", query = "", page = 1, total = 1, loading = false, items = {}, last = 0, opened = false }
local sbOrder, sbMore, sbBarTween = 0, nil, nil

local function sanitize(s)
	return (tostring(s):gsub("[^%w_%-]", ""))
end

--// Thumbnail: download -> writefile -> getcustomasset (hanya PNG/JPEG; webp tidak didukung Roblox)
local imgCache, imgPending, imgQueue, imgActive = {}, {}, {}, 0

local function loadRemoteImage(key, url)
	local getAsset = getcustomasset or getsynasset
	if not (writefile and isfile and getAsset) then
		return nil
	end
	if type(url) ~= "string" or url == "" then
		return nil
	end
	if url:sub(1, 1) == "/" then
		url = "https://scriptblox.com" .. url
	end
	local base = FOLDER .. "/img/" .. sanitize(key)
	for _, ext in ipairs({ ".png", ".jpg" }) do
		if isfile(base .. ext) then
			local ok, id = pcall(getAsset, base .. ext)
			if ok and id then
				return id
			end
		end
	end
	local data = httpGet(url)
	if not data or #data < 16 then
		return nil
	end
	local ext
	if data:sub(1, 4) == "\137PNG" then
		ext = ".png"
	elseif data:sub(1, 3) == "\255\216\255" then
		ext = ".jpg"
	else
		return nil
	end
	ensureFolder(FOLDER)
	ensureFolder(FOLDER .. "/img")
	pcall(writefile, base .. ext, data)
	local ok, id = pcall(getAsset, base .. ext)
	if ok and id then
		return id
	end
	return nil
end

local pumpImages
pumpImages = function()
	while imgActive < 3 and #imgQueue > 0 do
		local job = table.remove(imgQueue, 1)
		imgActive += 1
		task.spawn(function()
			local id = loadRemoteImage(job.key, job.url)
			imgCache[job.key] = id or false
			imgPending[job.key] = nil
			imgActive -= 1
			for _, cb in ipairs(job.cbs) do
				pcall(cb, id)
			end
			pumpImages()
		end)
	end
end

local function requestImage(key, url, cb)
	if imgCache[key] ~= nil then
		cb(imgCache[key] or nil)
		return
	end
	if imgPending[key] then
		table.insert(imgPending[key].cbs, cb)
		return
	end
	local job = { key = key, url = url, cbs = { cb } }
	imgPending[key] = job
	table.insert(imgQueue, job)
	pumpImages()
end

--// Request JSON
local function sbRequest(mode, query, page)
	local url
	if mode == "trending" then
		url = API .. "/script/trending"
	elseif mode == "search" then
		url = ("%s/script/search?q=%s&page=%d&max=20"):format(API, HttpService:UrlEncode(query), page)
	else
		url = ("%s/script/fetch?page=%d&max=20"):format(API, page)
	end
	local raw = httpGet(url)
	if not raw then
		return nil, "Tidak bisa terhubung ke ScriptBlox (cek HTTP executor / jaringan)"
	end
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" or type(data.result) ~= "table" then
		return nil, "Respons ScriptBlox tidak valid"
	end
	return data.result
end

local function sbBusy(on)
	if sbBarTween then
		sbBarTween:Cancel()
		sbBarTween = nil
	end
	if on then
		sbBar.Visible = true
		sbBar.Position = UDim2.fromScale(-0.35, 0)
		sbBarTween = TweenService:Create(
			sbBar,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, -1),
			{ Position = UDim2.fromScale(1, 0) }
		)
		sbBarTween:Play()
	else
		sbBar.Visible = false
	end
end

