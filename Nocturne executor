--// ========== Kompatibilitas ==========
local task = task or {
	spawn = function(f, ...)
		local co = coroutine.create(f)
		coroutine.resume(co, ...)
		return co
	end,
	defer = function(f, ...)
		return coroutine.wrap(f)(...)
	end,
	delay = function(t, f, ...)
		local a = { ... }
		coroutine.wrap(function()
			wait(t)
			f(unpack(a))
		end)()
	end,
	wait = wait,
}

local lp = Players.LocalPlayer
while not lp do
	task.wait()
	lp = Players.LocalPlayer
end

local function getEnv()
	local ok, e = pcall(function()
		return getgenv and getgenv()
	end)
	if ok and type(e) == "table" then
		return e
	end
	return _G
end
local ENV = getEnv()

local function exists(name)
	local ok, v = pcall(function()
		return ENV[name]
	end)
	if ok and v ~= nil then
		return true
	end
	local ok2, v2 = pcall(function()
		return _G[name]
	end)
	return ok2 and v2 ~= nil
end

-- cari loadstring yang benar-benar bekerja
local function findLoadstring()
	local list = {}
	if type(loadstring) == "function" then
		list[#list + 1] = loadstring
	end
	if type(ENV.loadstring) == "function" then
		list[#list + 1] = ENV.loadstring
	end
	local ok, r = pcall(function()
		return getrenv and getrenv().loadstring
	end)
	if ok and type(r) == "function" then
		list[#list + 1] = r
	end
	for _, f in ipairs(list) do
		local ok2, res = pcall(function()
			local fn = f("return 1")
			return fn and fn()
		end)
		if ok2 and res == 1 then
			return f
		end
	end
	return nil
end
local LS = findLoadstring()

