local function ensureFolder(path)
	path = path or FOLDER
	if makefolder and isfolder and not isfolder(path) then
		pcall(makefolder, path)
	end
end

local function loadIcon(key)
	if not (writefile and isfile and getAsset) then
		return nil
	end
	local cat, name = ICONS[key][1], ICONS[key][2]
	local path = FOLDER .. "/" .. key .. ".png"
	if not isfile(path) then
		ensureFolder()
		local data
		for _, sz in ipairs({ "2x_web", "1x_web" }) do
			local d = httpGet(("%s%s/%s/ic_%s_white_24dp.png"):format(CDN, cat, sz, name))
			if d and d:sub(2, 4) == "PNG" then
				data = d
				break
			end
		end
		if not data then
			return nil
		end
		pcall(writefile, path, data)
	end
	local ok, id = pcall(getAsset, path)
	if ok and id then
		return id
	end
	return nil
end

local ids, waiting = {}, {}

local function applyIcon(h, id)
	if not h.img.Parent then
		return
	end
	if id then
		h.img.Image = id
		tw(h.img, 0.2, { ImageTransparency = 0 })
	else
		h.fb.Visible = true
	end
end

local function icon(parent, key, px, pos, color, fbText)
	local h = {}
	h.img = create("ImageLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(px, px),
		ImageColor3 = color,
		ImageTransparency = 1,
		ScaleType = Enum.ScaleType.Fit,
		Parent = parent,
	})
	h.fb = create("TextLabel", {
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(px, px),
		Text = fbText or "",
		Font = Enum.Font.GothamBold,
		TextSize = px - 3,
		TextColor3 = color,
		Visible = false,
		Parent = parent,
	})
	if ids[key] ~= nil then
		applyIcon(h, ids[key] or nil)
	else
		waiting[key] = waiting[key] or {}
		table.insert(waiting[key], h)
	end
	return h
end

local function tint(h, color, t)
	tw(h.img, t or 0.1, { ImageColor3 = color })
	tw(h.fb, t or 0.1, { TextColor3 = color })
end

