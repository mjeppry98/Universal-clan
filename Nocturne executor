local tabObjs = {}

local refreshTabs, refreshLibrary, setActive, closeTab

local function byId(id)
	if id == nil then
		return nil
	end
	for _, s in ipairs(store.scripts) do
		if s.id == id then
			return s
		end
	end
	return nil
end

local function persist()
	if not writefile then
		return false
	end
	local ok = pcall(function()
		ensureFolder()
		writefile(
			DATA,
			HttpService:JSONEncode({
				nextId = store.nextId,
				folders = store.folders,
				scripts = store.scripts,
				open = openTabs,
				active = activeId,
			})
		)
	end)
	return ok
end

local function loadStore()
	local ok, raw = pcall(function()
		if isfile and readfile and isfile(DATA) then
			return readfile(DATA)
		end
		return nil
	end)
	if not (ok and raw) then
		return nil
	end
	local ok2, t = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not (ok2 and type(t) == "table") then
		return nil
	end
	store.nextId = tonumber(t.nextId) or 1
	store.folders = {}
	for _, f in ipairs(t.folders or {}) do
		if type(f) == "table" and type(f.name) == "string" then
			table.insert(store.folders, { name = f.name, open = f.open ~= false })
		end
	end
	store.scripts = {}
	for _, s in ipairs(t.scripts or {}) do
		if type(s) == "table" and s.id and type(s.name) == "string" then
			table.insert(store.scripts, {
				id = s.id,
				name = s.name,
				folder = type(s.folder) == "string" and s.folder or "",
				source = type(s.source) == "string" and s.source or "",
			})
			store.nextId = math.max(store.nextId, s.id + 1)
		end
	end
	return t
end

local function isDirty(id)
	local s = byId(id)
	if not s then
		return false
	end
	local txt = (id == activeId) and editor.Text or live[id]
	return txt ~= nil and txt ~= s.source
end

local function updateDirty()
	local o = activeId ~= nil and tabObjs[activeId] or nil
	if o and o.dot then
		o.dot.Visible = isDirty(activeId)
	end
end

local function freeName()
	local n = 1
	while true do
		local name = "Script " .. n
		local used = false
		for _, s in ipairs(store.scripts) do
			if s.name == name then
				used = true
				break
			end
		end
		if not used then
			return name
		end
		n += 1
	end
end

local function nameTaken(name, folder, exceptId)
	for _, s in ipairs(store.scripts) do
		if s.id ~= exceptId and (s.folder or "") == (folder or "") and s.name:lower() == name:lower() then
			return true
		end
	end
	return false
end

local function uniqueName(base, folder, exceptId)
	if not nameTaken(base, folder, exceptId) then
		return base
	end
	local n = 2
	while nameTaken(("%s (%d)"):format(base, n), folder, exceptId) do
		n += 1
	end
	return ("%s (%d)"):format(base, n)
end

local function folderTaken(name, exceptName)
	for _, f in ipairs(store.folders) do
		if f.name ~= exceptName and f.name:lower() == name:lower() then
			return true
		end
	end
	return false
end

local function validName(v)
	v = (v or ""):match("^%s*(.-)%s*$")
	if v == "" then
		return nil, "Nama tidak boleh kosong"
	end
	if #v > 28 then
		return nil, "Maksimal 28 karakter"
	end
	return v
end

local function addScript(name, folder, source)
	local s = { id = store.nextId, name = name, folder = folder or "", source = source or "" }
	store.nextId += 1
	table.insert(store.scripts, s)
	return s
end

local function createScript(folder)
	return addScript(freeName(), folder, "")
end

--// Keadaan kosong: tidak ada script yang terbuka (tidak membuat script baru otomatis)
local function showEmpty()
	activeId = nil
	loading = true
	editor.Text = ""
	loading = false
	editorScroll.CanvasPosition = Vector2.new(0, 0)
	refreshTabs()
	refreshLibrary()
end

--// ----- Tab strip -----
