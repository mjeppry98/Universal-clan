		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.Code,
		TextSize = 12,
		TextColor3 = col,
		TextTransparency = 1,
		Text = ("%s  %-5s %s"):format(os.date("%H:%M:%S"), tag, tostring(msg)),
		LayoutOrder = logCount,
		Parent = consoleScroll,
	})
	tw(l, 0.15, { TextTransparency = 0 })
	table.insert(entries, l)
	if #entries > 150 then
		table.remove(entries, 1):Destroy()
	end
	task.defer(function()
		if consoleScroll.Parent then
			consoleScroll.CanvasPosition = Vector2.new(0, 1e6)
