		input.FocusLost:Connect(function(enter)
			if enter then
				submit()
			end
		end)
	end

	dialogOpen = true
	overlay.Visible = true
	card.GroupTransparency = 1
	cardScale.Scale = 0.94
	tw(overlay, 0.12, { BackgroundTransparency = 0.4 })
	tw(card, 0.14, { GroupTransparency = 0 })
	tw(cardScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	if input then
		task.delay(0.16, function()
			if dialogOpen and input.Parent then
				input:CaptureFocus()
				input.SelectionStart = 1
				input.CursorPosition = #input.Text + 1
			end
		end)
	end
