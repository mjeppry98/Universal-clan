--// ========== Helper ==========
local conns = {} -- hanya untuk event service (global)
local function connect(sig, fn)
	local c = sig:Connect(fn)
	table.insert(conns, c)
	return c
end

local function create(class, props, kids)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			o[k] = v
		end
	end
	for _, k in ipairs(kids or {}) do
		k.Parent = o
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end

local function corner(o, r)
	return create("UICorner", { CornerRadius = UDim.new(0, r), Parent = o })
end

local function tw(o, t, p, style, dir)
	local tween = TweenService:Create(
		o,
		TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
		p
	)
	tween:Play()
	return tween
end

local function line(parent, props)
	props.BackgroundColor3 = C.line
	props.BorderSizePixel = 0
	props.Parent = parent
	return create("Frame", props)
end

local function hoverBg(b, base, over, press)
	b.MouseEnter:Connect(function()
		tw(b, 0.08, { BackgroundColor3 = over })
	end)
	b.MouseLeave:Connect(function()
		tw(b, 0.08, { BackgroundColor3 = base })
	end)
	b.MouseButton1Down:Connect(function()
		tw(b, 0.05, { BackgroundColor3 = press })
	end)
	b.MouseButton1Up:Connect(function()
		tw(b, 0.1, { BackgroundColor3 = over })
	end)
end

local function textButton(parent, text, bg, fg, w, h)
	local b = create("TextButton", {
		Text = text,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = fg,
		AutoButtonColor = false,
		BackgroundColor3 = bg,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(w, h),
		Parent = parent,
	})
	corner(b, 5)
	hoverBg(b, bg, bg:Lerp(Color3.new(1, 1, 1), 0.09), bg:Lerp(Color3.new(0, 0, 0), 0.2))
	return b
end

