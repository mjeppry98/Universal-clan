local function render(shapes, n, sw)
	local px, hw = {}, sw / 2
	for y = 0, n - 1 do
		for x = 0, n - 1 do
			local cx, cy, d = x + .5, y + .5, 1e9
			for i = 1, #shapes do
				local s, k, v = shapes[i], shapes[i][1], 0
				if k == 1 then
					local dx, dy = s[4] - s[2], s[5] - s[3]
					local t = ((cx - s[2]) * dx + (cy - s[3]) * dy) / (dx * dx + dy * dy + 1e-9)
					t = t < 0 and 0 or (t > 1 and 1 or t)
					local ex, ey = cx - (s[2] + dx * t), cy - (s[3] + dy * t)
					v = math.sqrt(ex * ex + ey * ey) - hw
				elseif k == 2 then
					v = math.abs(math.sqrt((cx - s[2]) ^ 2 + (cy - s[3]) ^ 2) - s[4]) - hw
				elseif k == 3 then
					v = math.sqrt((cx - s[2]) ^ 2 + (cy - s[3]) ^ 2) - s[4]
				else
					local qx = math.abs(cx - (s[2] + s[4] / 2)) - s[4] / 2 + s[6]
					local qy = math.abs(cy - (s[3] + s[5] / 2)) - s[5] / 2 + s[6]
					v = math.sqrt(math.max(qx, 0) ^ 2 + math.max(qy, 0) ^ 2) + math.min(math.max(qx, qy), 0) - s[6]
				end
				if v < d then d = v end
			end
			local i = (y * n + x) * 4
			px[i + 1], px[i + 2], px[i + 3] = 255, 255, 255
			px[i + 4] = math.floor(math.clamp(.5 - d, 0, 1) * 255 + .5)
		end
	end
	return png(n, n, px)
end

local getasset = getcustomasset or getsynasset
local cache = {}
local function asset(name, make)
	if cache[name] then return cache[name] end
	if not (writefile and isfile and getasset) then return "" end
	local dir = Senja.Folder .. "/assets"
	pcall(function()
		if not isfolder(Senja.Folder) then makefolder(Senja.Folder) end
		if not isfolder(dir) then makefolder(dir) end
	end)
	local path = dir .. "/" .. name .. ".png"
	local ok, res = pcall(function()
		if not isfile(path) then writefile(path, make()) end
		return getasset(path)
	end)
	if ok and res then cache[name] = res return res end
	return ""
end

function Senja.Icon(n)
	if type(n) == "number" then return "rbxassetid://" .. n end
	if type(n) ~= "string" or n == "" then return "" end
	if n:find("rbxasset") or n:find("^http") then return n end
	local f = Draw[n]
	if not f then return "" end
	return asset("v1_" .. n, function() return render(f(), 64, 5.4) end)
end
function Senja:AddIcon(name, fn) Draw[name] = fn end

local function img(p, name, sz, key)
	local i = new("ImageLabel", {BackgroundTransparency = 1, Size = UDim2.fromOffset(sz, sz), Image = Senja.Icon(name), Parent = p})
	if typeof(key) == "Color3" then i.ImageColor3 = key else bind(i, "ImageColor3", key or "Sub") end
	return i
end

------------------------------------------------------------ drag generik (slider, color picker)
local function dragger(win, frame, fn, onStart, onEnd)
	local on = false
	frame.InputBegan:Connect(function(i)
		if i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch then
			on = true
			if onStart then onStart() end
			fn(i.Position)
		end
	end)
	win:_c(UIS.InputChanged, function(i)
		if on and (i.UserInputType == E.UserInputType.MouseMovement or i.UserInputType == E.UserInputType.Touch) then fn(i.Position) end
	end)
	win:_c(UIS.InputEnded, function(i)
		if on and (i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch) then
			on = false
			if onEnd then onEnd() end
		end
	end)
end

