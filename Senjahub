end

local function notifTick(dt)
	for i = #notifActive, 1, -1 do
		local e = notifActive[i]
		if e and not e.closed then
			if not (e.hover or e.drag) then e.left -= dt end
			if e.left <= 0 then task.spawn(e.close) end
		end
	end
	if #notifActive == 0 and notifConn then
		notifConn:Disconnect()
		notifConn = nil
	end
end

function Senja:Notify(o)
	if type(o) == "string" then o = {Content = o} end
	task.spawn(function()
		local hold = getNotif()
		local kind = o.Type or "info"
		local title, body = o.Title, o.Content
		if not title then title, body = body or "Pemberitahuan", nil end
		local dur = o.Duration or 4
		local key = kind .. "|" .. tostring(title) .. "|" .. tostring(body)

		-- pesan yang sama: tambah hitungan, ulang waktu, geser sedikit
		for _, e in ipairs(notifActive) do
			if e.key == key and not e.closed then
				e.count += 1
				e.left = dur
				e.cnt.Text = "×" .. e.count
				e.cnt.Visible = true
				if not e.drag then
					e.card.Position = UDim2.fromOffset(8, 0)
					tw(e.card, {Position = UDim2.new()}, .18)
				end
				return
			end
		end

		notifN += 1
		local col = KindCol[kind] or Cur.Accent
		local wrap = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = notifN, Parent = hold})
		local card = new("Frame", {Active = true, BackgroundColor3 = Cur.Surface, Position = UDim2.fromOffset(OFF, 0),
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = wrap})
		corner(card, 14)
		new("UIStroke", {Color = Cur.Stroke, Thickness = 1, ApplyStrokeMode = E.ApplyStrokeMode.Border, Parent = card})
		pad(card, 12, 12, 14, 12)

		local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = card})

		-- ikon besar
		local badge = new("Frame", {BackgroundColor3 = col, BackgroundTransparency = .86, Size = UDim2.fromOffset(40, 40), Parent = row})
		corner(badge, 12)
		local bs = new("UIScale", {Scale = .7, Parent = badge})
		local src = Senja.Icon(KindIcon[kind] or "info")
		if src ~= "" then
			new("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
				Size = UDim2.fromOffset(22, 22), Image = src, ImageColor3 = col, Parent = badge})
		else
			new("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = KindGlyph[kind] or "i", TextSize = 22,
				FontFace = font(E.FontWeight.Bold), TextColor3 = col, Parent = badge})
		end

		-- teks (tinggi minimal 40 = tinggi ikon, isinya di tengah kalau cuma satu baris)
		local inner = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(52, 0), Size = UDim2.new(1, -78, 0, 40), AutomaticSize = AY, Parent = row})
		new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = E.SortOrder.LayoutOrder, VerticalAlignment = E.VerticalAlignment.Center, Parent = inner})
		tlabel(inner, title, 13, Cur.Text, E.FontWeight.SemiBold, 1)
		if body then tlabel(inner, body, 12, Cur.Sub, E.FontWeight.Medium, 2) end

		local cnt = new("TextLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(24, 14),
			Text = "", TextSize = 11, FontFace = font(E.FontWeight.SemiBold), TextColor3 = Cur.Sub, TextXAlignment = E.TextXAlignment.Right, Visible = false, Parent = row})

		local e = {key = key, card = card, cnt = cnt, count = 1, left = dur, closed = false, drag = false, hover = false}
		notifActive[#notifActive + 1] = e

		local function close()
			if e.closed then return end
			e.closed = true
			local i = table.find(notifActive, e)
			if i then table.remove(notifActive, i) end
			-- tunggu kartu benar-benar keluar layar baru ruangnya dirapatkan, supaya tidak menimpa kartu di bawahnya
			tw(card, {Position = UDim2.fromOffset(OFF, 0)}, .18).Completed:Wait()
			if not wrap.Parent then return end
			wrap.AutomaticSize = E.AutomaticSize.None
			wrap.Size = UDim2.new(1, 0, 0, wrap.AbsoluteSize.Y)
			wrap.ClipsDescendants = true
			tw(wrap, {Size = UDim2.new(1, 0, 0, 0)}, .14).Completed:Wait()
			wrap:Destroy()
		end
		e.close = close

		local inT = tw(card, {Position = UDim2.new()}, .26, Qn)
		tw(bs, {Scale = 1}, .28, Qn)

		while #notifActive > 5 do
			local old = notifActive[1]
			if old == e then break end
			task.spawn(old.close)
		end

		if not notifConn then notifConn = RunService.Heartbeat:Connect(notifTick) end

		card.MouseEnter:Connect(function() e.hover = true end)
		card.MouseLeave:Connect(function() e.hover = false end)

		card.InputBegan:Connect(function(i)
			if e.closed or e.drag or not isPtr(i) then return end
			inT:Cancel()
			e.drag = true
			local x0, dx, lt, vel = i.Position.X, 0, os.clock(), 0
			ptrDrag(function(m)
				if e.closed then return end
				local nx, now = m.Position.X - x0, os.clock()
				vel = vel * .6 + ((nx - dx) / math.max(now - lt, .001)) * .4
				dx, lt = nx, now
				card.Position = UDim2.fromOffset(dx > 0 and dx or dx * .2, 0)
			end, function()
				e.drag = false
				if e.closed then return end
				if math.abs(dx) < 5 then
					if o.Callback then safe(o.Callback) end
					task.spawn(close)
				elseif dx > 70 or vel > 600 then
					task.spawn(close)
				else
					tw(card, {Position = UDim2.new()}, .18)
				end
			end)
		end)
	end)
end

function Senja:ClearNotifications()
	for i = #notifActive, 1, -1 do
		local e = notifActive[i]
		if e and e.close then task.spawn(e.close) end
	end
end

