	corner(wg, 4) new("UIGradient", {Transparency = NumberSequence.new(0, 1), Parent = wg})
	local bk = new("Frame", {Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, Parent = sv})
	corner(bk, 4) new("UIGradient", {Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = bk})
	local cur = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, Parent = sv})
	corner(cur, 5) new("UIStroke", {Color = WHITE, Thickness = 2, Parent = cur})
	local hue = new("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 10), Size = UDim2.fromOffset(14, 104), Active = true, BackgroundColor3 = WHITE, Parent = body})
	corner(hue, 4)
	local ks = {}
	for i = 0, 6 do ks[#ks + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, .999), 1, 1)) end
	new("UIGradient", {Rotation = 90, Color = ColorSequence.new(ks), Parent = hue})
	local hc = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.new(1, 4, 0, 3), BackgroundColor3 = WHITE, Parent = hue})
	corner(hc, 1) new("UIStroke", {Color = BLACK, Transparency = .5, Thickness = 1, Parent = hc})
	local function upd(silent)
		local col = Color3.fromHSV(H, S, V)
		sv.BackgroundColor3 = Color3.fromHSV(H, 1, 1)
		sw.BackgroundColor3 = col
		cur.Position = UDim2.fromScale(S, 1 - V)
		hc.Position = UDim2.fromScale(.5, H)
		hex.Text = string.format("#%02X%02X%02X", math.floor(col.R * 255 + .5), math.floor(col.G * 255 + .5), math.floor(col.B * 255 + .5))
		obj.Value = col
		if not silent then safe(o.Callback, col) end
	end
	dragger(self.Win, sv, function(p)
		local m = ptr(p)
		S = math.clamp((m.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
		V = 1 - math.clamp((m.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
		upd()
	end, function() self:_lock(true) end, function() self:_lock(false) end)
	dragger(self.Win, hue, function(p)
		local m = ptr(p)
		H = math.clamp((m.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 1)
		upd()
	end, function() self:_lock(true) end, function() self:_lock(false) end)
	local open = false
	sw.MouseButton1Click:Connect(function()
		open = not open
		tw(body, {Size = UDim2.new(1, 0, 0, open and 118 or 0)}, .24)
	end)
	function obj:Set(v, silent)
		if type(v) == "string" then
			local r, g, b = v:match("^#?(%x%x)(%x%x)(%x%x)$")
			if not r then return end
			v = C3(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
		end
		H, S, V = Color3.toHSV(v)
		upd(silent)
	end
	function obj:Get() return self.Value end
	function obj:Serialize() return hex.Text end
	hex.FocusLost:Connect(function() obj:Set(hex.Text) end)
	upd(true)
	return reg(o, obj)
end

