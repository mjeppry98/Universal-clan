-- elemen yang langsung di tab (tanpa section) tampil sebagai baris berbingkai sendiri.
local Box = {}
Box.__index = Box
local function newBox(win, tab, body, grouped) return setmetatable({Win = win, Tab = tab, Body = body, Grouped = grouped, _cnt = 0}, Box) end
function Box:_n() self._cnt += 1 return self._cnt end
-- matikan scroll halaman selama slider / color picker digeser (kalau tidak, halaman ikut tergulir di layar sentuh)
function Box:_lock(on)
	local s = self.Tab and self.Tab.Scroll
	if s then s.ScrollingEnabled = not on end
end
local function reg(o, obj) if o.Flag then Senja.Flags[o.Flag] = obj end return obj end

function Box:_row(o, cw, wantHit)
	local n = self:_n()
	local h = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = n, Parent = self.Body})
	pad(h, 11, 9, 11, 9)
	corner(h, 4)
	local function hov(on)
		if self.Grouped then tw(h, {BackgroundTransparency = on and 0 or 1, BackgroundColor3 = Cur.Hover}, .1)
		else tw(h, {BackgroundColor3 = on and Cur.Hover or Cur.Surface}, .1) end
	end
	local function press(on) tw(h, {BackgroundColor3 = on and Cur.Track or Cur.Hover}, .06) end
	if self.Grouped then
		bind(h, "BackgroundColor3", "Hover")
		h.BackgroundTransparency = 1
		if n > 1 then
			local d = new("Frame", {Position = UDim2.fromOffset(-11, -9), Size = UDim2.new(1, 22, 0, 1), Parent = h})
			bind(d, "BackgroundColor3", "Stroke")
		end
	else
		bind(h, "BackgroundColor3", "Surface")
		stroke(h, "Stroke", 1, 0)
	end
	local col = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = h})
	new("UIListLayout", {SortOrder = E.SortOrder.LayoutOrder, Parent = col})
	local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = 1, Parent = col})
	local box = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -(cw or 0) - 10, 0, 0), AutomaticSize = AY, Parent = row})
	new("UIListLayout", {Padding = UDim.new(0, 2), Parent = box})
	local t = label(box, o.Title or "", 13, "Text")
	local d
	if o.Description and o.Description ~= "" then
		d = label(box, o.Description, 11, "Sub")
		d.TextWrapped, d.AutomaticSize, d.Size = true, AY, UDim2.new(1, 0, 0, 0)
	end
	local hit
	if wantHit then
		local bar = new("Frame", {Position = UDim2.fromOffset(-11, -5), Size = UDim2.new(0, 2, 1, 10), ZIndex = 4, Parent = h})
		bind(bar, "BackgroundColor3", "Accent")
		bar.BackgroundTransparency = 1
		hit = new("TextButton", {BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(-11, -9), Size = UDim2.new(1, 22, 1, 18), ZIndex = 5, Parent = h})
		hit.MouseEnter:Connect(function() hov(true) tw(bar, {BackgroundTransparency = 0}, .12) end)
		hit.MouseLeave:Connect(function() hov(false) tw(bar, {BackgroundTransparency = 1}, .15) end)
		hit.MouseButton1Down:Connect(function() press(true) end)
		hit.MouseButton1Up:Connect(function() press(false) end)
	end
	table.insert(self.Tab.Items, {holder = h, title = o.Title or "", box = self})
	return {h = h, row = row, box = box, col = col, hit = hit, title = t, desc = d}
end

