local function L(x1, y1, x2, y2) return {{1, x1, y1, x2, y2}} end
local function ring(x, y, r) return {{2, x, y, r}} end
local function disc(x, y, r) return {{3, x, y, r}} end
local function rbox(x, y, w, h, r) return {{4, x, y, w, h, r}} end
local function cat(...)
	local o = {}
	for _, t in ipairs({...}) do for _, s in ipairs(t) do o[#o + 1] = s end end
	return o
end
local function poly(p, closed)
	local o = {}
	for i = 1, #p - 1 do o[#o + 1] = {1, p[i][1], p[i][2], p[i + 1][1], p[i + 1][2]} end
	if closed then o[#o + 1] = {1, p[#p][1], p[#p][2], p[1][1], p[1][2]} end
	return o
end
local function arc(cx, cy, r, a0, a1)
	local o, n = {}, 14
	for i = 0, n - 1 do
		local u, v = math.rad(a0 + (a1 - a0) * i / n), math.rad(a0 + (a1 - a0) * (i + 1) / n)
		o[#o + 1] = {1, cx + r * math.cos(u), cy + r * math.sin(u), cx + r * math.cos(v), cy + r * math.sin(v)}
	end
	return o
end
local function bez(a, b, c)
	local pts = {}
	for i = 0, 14 do
		local t = i / 14
		pts[#pts + 1] = {(1 - t) ^ 2 * a[1] + 2 * (1 - t) * t * b[1] + t * t * c[1], (1 - t) ^ 2 * a[2] + 2 * (1 - t) * t * b[2] + t * t * c[2]}
	end
	return poly(pts)
end

