local function ptrDrag(move, finish)
	local cm, ce
	cm = UIS.InputChanged:Connect(function(i) if isMove(i) then move(i) end end)
	ce = UIS.InputEnded:Connect(function(i)
		if not isPtr(i) then return end
		cm:Disconnect() ce:Disconnect()
		if finish then finish(i) end
	end)
end

------------------------------------------------------------ PNG encoder (stored deflate)
local crcT = {}
for i = 0, 255 do
	local c = i
	for _ = 1, 8 do
		if bit32.band(c, 1) == 1 then c = bit32.bxor(bit32.rshift(c, 1), 0xEDB88320) else c = bit32.rshift(c, 1) end
	end
	crcT[i] = c
end
local function crc32(s)
	local c = 0xFFFFFFFF
	for i = 1, #s do c = bit32.bxor(crcT[bit32.band(bit32.bxor(c, string.byte(s, i)), 255)], bit32.rshift(c, 8)) end
	return bit32.bxor(c, 0xFFFFFFFF)
end
local function be32(n)
	return string.char(bit32.band(bit32.rshift(n, 24), 255), bit32.band(bit32.rshift(n, 16), 255), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255))
end
local function chunk(t, d) return be32(#d) .. t .. d .. be32(crc32(t .. d)) end

local function png(w, h, px)
	local rows = {}
	for y = 0, h - 1 do
		local r, base = {0}, y * w * 4
		for i = 1, w * 4 do r[i + 1] = px[base + i] end
		rows[#rows + 1] = string.char(table.unpack(r))
	end
	local raw = table.concat(rows)
	local z, pos, n = {"\120\1"}, 1, #raw
	while pos <= n do
		local len = math.min(65535, n - pos + 1)
		local nl = bit32.bxor(len, 0xFFFF)
		z[#z + 1] = string.char((pos + len > n) and 1 or 0, len % 256, math.floor(len / 256), nl % 256, math.floor(nl / 256))
		z[#z + 1] = raw:sub(pos, pos + len - 1)
		pos += len
	end
	local a, b = 1, 0
	for i = 1, n do a = (a + string.byte(raw, i)) % 65521 b = (b + a) % 65521 end
	z[#z + 1] = be32(b * 65536 + a)
	return "\137PNG\r\n\26\n" .. chunk("IHDR", be32(w) .. be32(h) .. "\8\6\0\0\0") .. chunk("IDAT", table.concat(z)) .. chunk("IEND", "")
end

