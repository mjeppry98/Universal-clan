local function dragger(win, frame, fn, onStart, onEnd)
	local busy = false
	frame.InputBegan:Connect(function(i)
		if busy or not isPtr(i) then return end
		busy = true
		if onStart then onStart() end
		fn(i.Position)
		ptrDrag(function(m) fn(m.Position) end, function()
			busy = false
			if onEnd then onEnd() end
		end)
	end)
end

