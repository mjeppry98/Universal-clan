function Box:AddSection(o)
	if type(o) == "string" then o = {Title = o} end
	local sec = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = self:_n(), Parent = self.Body})
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = E.SortOrder.LayoutOrder, Parent = sec})
	local head = new("TextButton", {BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Parent = sec})
	local hl = label(head, o.Title or "", 12, "Sub", E.FontWeight.SemiBold)
	hl.Position, hl.Size = UDim2.fromOffset(4, 0), UDim2.new(1, -24, 1, 0)
	local ar = img(head, "chevron", 11, "Sub")
	ar.AnchorPoint, ar.Position = Vector2.new(1, .5), UDim2.new(1, -4, .5, 0)
	local content = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, LayoutOrder = 2, Parent = sec})
	local group = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = content})
	local cl = new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = E.SortOrder.LayoutOrder, Parent = group})
	local open = o.Open ~= false
	ar.Rotation = open and 0 or -90

	-- faktor skala UI yang sedang berlaku (UIScale di window). AbsoluteSize / AbsoluteContentSize sudah terkena skala,
	-- sedangkan Size offset belum, jadi tinggi dari Absolute* harus dibagi faktor ini sebelum dipakai sebagai offset.
	-- (dulu tinggi section dipasang mentah dari AbsoluteContentSize, makanya isi section terpotong di skala UI selain 100%)
	local win = self.Win
	local function k()
		local r = win.Root
		local w, a = r.Size.X.Offset, r.AbsoluteSize.X
		return (w > 0 and a > 0) and a / w or 1
	end
	local secTw
	-- section terbuka dan diam: tinggi dibiarkan mengikuti isi (AutomaticSize), jadi tidak pernah terpotong
	-- dan tidak ada jeda saat isi berubah (dropdown dibuka, teks berganti, dll)
	local function settle()
		if open then
			content.AutomaticSize = AY
			content.Size = UDim2.new(1, 0, 0, 0)
			-- saat terbuka dan diam tidak perlu memotong isi, jadi tidak ada area klik yang ikut terpotong
			content.ClipsDescendants = false
		end
	end
	if open then settle() end

	local sub = newBox(self.Win, self.Tab, group)
	sub.IsOpen, sub.Frame = open, sec
	table.insert(self.Tab.Secs, sub)
	-- dipanggil saat tab ditampilkan: pastikan section terbuka kembali mengikuti isinya
	sub.Refresh = function()
		if open and not (secTw and secTw.PlaybackState == E.PlaybackState.Playing) then settle() end
	end
	function sub:SetOpen(v)
		open = v and true or false
		self.IsOpen = open
		if secTw then secTw:Cancel() end
		-- tinggi sekarang dan tinggi tujuan, dalam satuan offset
		local s = k()
		local from = content.AbsoluteSize.Y / s
		local to = open and math.max(group.AbsoluteSize.Y, cl.AbsoluteContentSize.Y) / s or 0
		content.AutomaticSize = E.AutomaticSize.None
		content.ClipsDescendants = true
		content.Size = UDim2.new(1, 0, 0, from)
		local mine = tw(content, {Size = UDim2.new(1, 0, 0, to)}, .2)
		secTw = mine
		-- setelah selesai, kembalikan ke AutomaticSize (isi bisa berubah selama animasi, mis. dropdown dibuka)
		mine.Completed:Connect(function(st)
			if mine == secTw and open and st == E.PlaybackState.Completed then settle() end
		end)
		tw(ar, {Rotation = open and 0 or -90}, .18)
	end
	head.MouseEnter:Connect(function() tw(hl, {TextColor3 = Cur.Text}, .08) end)
	head.MouseLeave:Connect(function() tw(hl, {TextColor3 = Cur.Sub}, .12) end)
	head.MouseButton1Click:Connect(function() sub:SetOpen(not open) end)
	return sub
end

-- pengaturan UI (tema, aksen, ukuran, kecepatan, dll) tersimpan otomatis ke Senja/ui.json dan dimuat lagi saat UI dijalankan
local Prefs = {}
local prefTok = 0
local function prefPath() return Senja.Folder .. "/ui.json" end
local function toHex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + .5), math.floor(c.G * 255 + .5), math.floor(c.B * 255 + .5))
end
local function fromHex(s)
	local r, g, b = tostring(s):match("^#?(%x%x)(%x%x)(%x%x)$")
	if r then return C3(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) end
end
local function loadPrefs()
	if not (readfile and isfile) then return {} end
	local ok, d = pcall(function()
		if not isfile(prefPath()) then return {} end
		return HttpService:JSONDecode(readfile(prefPath()))
	end)
	return (ok and type(d) == "table") and d or {}
end
local function pref(k, v)
	Prefs[k] = v
	if not writefile then return end
	prefTok += 1
	local t = prefTok
	task.delay(.5, function()
		if t ~= prefTok then return end
		pcall(function()
			if makefolder and isfolder and not isfolder(Senja.Folder) then makefolder(Senja.Folder) end
			writefile(prefPath(), HttpService:JSONEncode(Prefs))
		end)
	end)
end

