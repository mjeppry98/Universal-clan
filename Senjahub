	local ct = label(card, o.Content or "", 12, "Sub")
	ct.TextWrapped, ct.AutomaticSize, ct.Size, ct.LayoutOrder = true, AY, UDim2.new(1, 0, 0, 0), 2
	local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 3, Parent = card})
	pad(row, 0, 8, 0, 0)
	new("UIListLayout", {FillDirection = E.FillDirection.Horizontal, HorizontalAlignment = E.HorizontalAlignment.Right, Padding = UDim.new(0, 8), SortOrder = E.SortOrder.LayoutOrder, Parent = row})
	local function close()
		tw(us, {Scale = .96}, .1)
		tw(ov, {BackgroundTransparency = 1}, .1)
		task.wait(.1)
		ov:Destroy()
	end
	for i, b in ipairs(o.Buttons or {{Title = "OK"}}) do
		local bt = new("TextButton", {AutoButtonColor = false, Text = "", Size = UDim2.fromOffset(math.max(72, #b.Title * 7 + 28), 30), LayoutOrder = i, Parent = row})
		bind(bt, "BackgroundColor3", b.Primary and "Accent" or "Hover") corner(bt, 15)
		local bs = new("UIScale", {Parent = bt})
		local l = label(bt, b.Title, 12, b.Primary and "OnAccent" or "Text", E.FontWeight.SemiBold)
		l.Size, l.TextXAlignment = UDim2.fromScale(1, 1), E.TextXAlignment.Center
		bt.MouseEnter:Connect(function() tw(bt, {BackgroundTransparency = .12}, .08) end)
		bt.MouseLeave:Connect(function() tw(bt, {BackgroundTransparency = 0}, .1) tw(bs, {Scale = 1}, .12) end)
		bt.MouseButton1Down:Connect(function() tw(bs, {Scale = .95}, .05) end)
		bt.MouseButton1Up:Connect(function() tw(bs, {Scale = 1}, .14) end)
		bt.MouseButton1Click:Connect(function() task.spawn(close) safe(b.Callback) end)
	end
end

local function cfgPath(n) return Senja.Folder .. "/configs/" .. n .. ".json" end
function Window:_serialize()
	local d = {__theme = CurName}
	if AccentOverride then d.__accent = toHex(AccentOverride) end
	for f, ob in pairs(Senja.Flags) do if ob.Serialize then d[f] = ob:Serialize() end end
	return HttpService:JSONEncode(d)
end
local function ensureCfgDir()
	if not (makefolder and isfolder) then return end
	pcall(function()
		if not isfolder(Senja.Folder) then makefolder(Senja.Folder) end
		if not isfolder(Senja.Folder .. "/configs") then makefolder(Senja.Folder .. "/configs") end
	end)
end
function Window:SaveConfig(name)
	if not writefile then return false end
	name = tostring(name or "default"):gsub("[^%w_%-]", "")
	ensureCfgDir()
	local json = self:_serialize()
	local ok = pcall(writefile, cfgPath(name), json)
	if ok and name == Prefs.autoload then self._lastSave = json end
	return ok
end

-- config yang dipilih di Pengaturan ("Muat & simpan otomatis") dimuat lewat fungsi ini. panggil SETELAH semua elemen dibuat.
-- sesudahnya perubahan disimpan sendiri tiap 15 detik (hanya kalau ada yang berubah).
function Window:AutoLoad()
	local n = Prefs.autoload
	local loaded = false
	if n and readfile and isfile and isfile(cfgPath(n)) then loaded = self:LoadConfig(n) end
	if n then
		self.AutoReady = true
		self._lastSave = loaded and self:_serialize() or nil
	end
	return loaded
end
function Window:_autoSave()
	local n = Prefs.autoload
	if not (n and self.AutoReady and writefile) then return end
	local json = self:_serialize()
	if json == self._lastSave then return end
	ensureCfgDir()
	if pcall(writefile, cfgPath(n), json) then self._lastSave = json end
end
function Window:LoadConfig(name)
	if not (readfile and isfile) or not isfile(cfgPath(name)) then return false end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
	if not ok then return false end
	if d.__theme then Senja:SetTheme(d.__theme) end
	if d.__accent then
		local r, g, b = tostring(d.__accent):match("^#?(%x%x)(%x%x)(%x%x)$")
		if r then Senja:SetAccent(C3(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))) end
	end
	for f, v in pairs(d) do
		local ob = Senja.Flags[f]
		if ob and ob.Set then pcall(ob.Set, ob, v) end
	end
	return true
end
function Window:ListConfigs()
	local r = {}
	if listfiles and isfolder and isfolder(Senja.Folder .. "/configs") then
		for _, p in ipairs(listfiles(Senja.Folder .. "/configs")) do
			local n = p:match("([^/\\]+)%.json$")
			if n then r[#r + 1] = n end
		end
	end
	return r
end

