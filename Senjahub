	local obj = {Type = "Keybind", Key = o.Default or E.KeyCode.Unknown, State = false}
	local btn = new("TextButton", {AutoButtonColor = false, Text = "", AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(70, 22), Parent = c.row})
	bind(btn, "BackgroundColor3", "Bg") corner(btn, 3)
	local st = stroke(btn, "Stroke", 1, 0)
	local kl = label(btn, "", 12, "Text")
	kl.Size, kl.TextXAlignment = UDim2.fromScale(1, 1), E.TextXAlignment.Center
	local listening = false
	local function show() kl.Text = obj.Key == E.KeyCode.Unknown and "none" or obj.Key.Name end
	function obj:Set(k, silent)
		if type(k) == "string" then k = E.KeyCode[k] or E.KeyCode.Unknown end
		self.Key = k
		show()
		if not silent then safe(o.Changed, k) end
	end
	function obj:Get() return self.Key end
	function obj:Serialize() return self.Key.Name end
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		kl.Text = "..."
		tw(st, {Color = Cur.Accent}, .12)
		local cn
		cn = UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= E.UserInputType.Keyboard then return end
			cn:Disconnect()
			listening = false
			tw(st, {Color = Cur.Stroke}, .15)
			obj:Set(i.KeyCode == E.KeyCode.Escape and E.KeyCode.Unknown or i.KeyCode)
		end)
	end)
	self.Win:_c(UIS.InputBegan, function(i, gp)
		if gp or listening or obj.Key == E.KeyCode.Unknown or i.KeyCode ~= obj.Key then return end
		if mode == "Toggle" then obj.State = not obj.State safe(o.Callback, obj.State)
		elseif mode == "Hold" then safe(o.Callback, true)
		else safe(o.Callback) end
	end)
	if mode == "Hold" then
		self.Win:_c(UIS.InputEnded, function(i) if i.KeyCode == obj.Key then safe(o.Callback, false) end end)
	end
	obj:Set(obj.Key, true)
	return reg(o, obj)
end

