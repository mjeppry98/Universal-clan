local Window = {}
Window.__index = Window

function Window:_c(sig, fn)
	local c = sig:Connect(fn)
	self.Conns[#self.Conns + 1] = c
	return c
end

-- tween efek gagang dicatat supaya bisa dibatalkan saat mulai ditarik
local function fxTw(fx, ...)
	local t = tw(...)
	fx.tweens[#fx.tweens + 1] = t
	if #fx.tweens > 12 then table.remove(fx.tweens, 1) end
	return t
end

-- posisi Y (piksel) saat terbuka dan saat tersembunyi di atas layar
function Window:_px()
	local hy = self.Home.Y.Scale * workspace.CurrentCamera.ViewportSize.Y + self.Home.Y.Offset
	local cy = -(self.Root.Size.Y.Offset * self.UserScale) / 2 - 24
	return hy, cy
end
function Window:_at(y)
	self.Root.Position = UDim2.new(self.Home.X.Scale, self.Home.X.Offset, 0, y)
end
function Window:_stop()
	for _, t in ipairs(self._tws) do t:Cancel() end
	self._tws = {}
end
-- p: 0 = tertutup, 1 = terbuka penuh. dipakai saat ditarik: posisi, ukuran, dan redupnya latar ikut p
function Window:_progress(p)
	local hy, cy = self:_px()
	self:_at(cy + (hy - cy) * p)
	self.Scale.Scale = self.UserScale * (.94 + .06 * p)
	self.Dim.BackgroundTransparency = 1 - (1 - self.DimT) * p
end
function Window:_go(open)
	self:_stop()
	local _, cy = self:_px()
	local dur = open and .34 or .26
	local ez = open and Qn or Q
	self._tws = {
		tw(self.Root, {Position = open and self.Home or UDim2.new(self.Home.X.Scale, self.Home.X.Offset, 0, cy)}, dur, ez),
		tw(self.Scale, {Scale = open and self.UserScale or self.UserScale * .94}, dur, ez),
		tw(self.Dim, {BackgroundTransparency = open and self.DimT or 1}, dur, ez),
	}
end

-- gagang atas: ikut ditarik, melebar, berubah warna saat sudah cukup jauh
function Window:_pull(p, over)
	local fx = self.HandleFx
	if not self.Pulling then
		for _, t in ipairs(fx.tweens) do t:Cancel() end
		fx.tweens = {}
	end
	self.Pulling = true
	fx.pill.Position = UDim2.new(.5, 0, 0, fx.base + 56 * p)
	fx.pill.Size = UDim2.fromOffset(fx.w + 70 * p, 5 + 2 * p)
	fx.hint.Position = UDim2.new(.5, 0, 0, fx.base + 16 + 56 * p)
	if over ~= fx.over then
		fx.over = over
		fx.hint.Text = over and "Lepas untuk membuka" or "Tarik ke bawah"
		fxTw(fx, fx.pill, {BackgroundColor3 = over and Cur.Accent or WHITE, BackgroundTransparency = over and 0 or .3}, .1)
	end
	fx.hint.TextTransparency, fx.hint.TextStrokeTransparency = 0, .75
end
function Window:_pullReset(inst)
	local fx = self.HandleFx
	self.Pulling, fx.over = false, false
	local t = inst and 0 or .2
	fx.hint.Text = "Tarik ke bawah"
	fxTw(fx, fx.pill, {Position = UDim2.new(.5, 0, 0, fx.base), Size = UDim2.fromOffset(fx.w, 5), BackgroundColor3 = WHITE, BackgroundTransparency = .3}, t)
	fxTw(fx, fx.hint, {Position = UDim2.new(.5, 0, 0, fx.base + 16), TextTransparency = 1, TextStrokeTransparency = 1}, t)
end
function Window:_flashHint()
	local fx = self.HandleFx
	fxTw(fx, fx.hint, {TextTransparency = 0, TextStrokeTransparency = .75}, .2)
	task.delay(2.4, function()
		if not self.Pulling and not fx.hover then fxTw(fx, fx.hint, {TextTransparency = 1, TextStrokeTransparency = 1}, .3) end
	end)
end
-- garis bawah window saat ditarik ke atas
function Window:_grabFx(over)
	local g = self.GrabFx.pill
	tw(g, {BackgroundColor3 = over and Cur.Accent or Cur.Sub, BackgroundTransparency = over and 0 or .55, Size = UDim2.fromOffset(over and 64 or 34, 3)}, .12)
end

function Window:Toggle(v)
	if v == nil then v = not self.Open end
	self.Open = v
	self._tok += 1
	local tok = self._tok
	if v then
		self.Root.Visible, self.Dim.Visible = true, true
		self:_go(true)
		self.Handle.Visible = false
		self:_pullReset(true)
	else
		local wasShown = self.Handle.Visible
		if self.Pulling then self:_pullReset(false) end
		self:_go(false)
		task.delay(.28, function()
			if self._tok == tok and not self.Open then
				self.Root.Visible, self.Dim.Visible = false, false
				self.Handle.Visible = true
				self:_pullReset(true)
				if not wasShown then self:_flashHint() end
			end
		end)
	end
end

function Window:SetScale(n)
	self.UserScale = n
	if self.Open then tw(self.Scale, {Scale = n}, .2) else self.Scale.Scale = n * .94 end
end

function Window:SetDim(on)
	self.DimT = on and .62 or 1
	if self.Open and not self.Pulling then tw(self.Dim, {BackgroundTransparency = self.DimT}, .2) end
end

function Window:Destroy()
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	self._tok += 1
	self.Open = false
	self.Handle.Visible = false
	self:_go(false)
	local i = table.find(Senja.Windows, self)
	if i then table.remove(Senja.Windows, i) end
	task.delay(.3, function() self.Gui:Destroy() end)
end

function Window:Select(tab)
	if self.Current == tab then return end
	local old = self.Current
	self.Current = tab
	if old then
		old._paint(false)
		local g = old.Group
		tw(g, {GroupTransparency = 1, Position = UDim2.fromOffset(0, -8)}, .12)
		task.delay(.12, function() if self.Current ~= old then g.Visible = false end end)
	end
	tab._paint(true)
	tab.Group.Position, tab.Group.GroupTransparency, tab.Group.Visible = UDim2.fromOffset(0, 12), 1, true
	tw(tab.Group, {GroupTransparency = 0, Position = UDim2.new()}, .22)
	self:_filter(self.SearchBox.Text)
	for _, s in ipairs(tab.Secs) do s.Refresh() end
	task.defer(function() for _, s in ipairs(tab.Secs) do s.Refresh() end end)
end

-- saring baris berdasarkan kata kunci. section tanpa hasil disembunyikan,
-- section tertutup yang punya hasil dibuka otomatis.
function Window:_filter(q)
	q = q:lower()
	local tab = self.Current
	if not tab then return end
	local hit = {}
	for _, it in ipairs(tab.Items) do
		local ok = q == "" or it.title:lower():find(q, 1, true) ~= nil
		it.holder.Visible = ok
		if ok then hit[it.box] = true end
	end
	for _, s in ipairs(tab.Secs) do
		s.Frame.Visible = q == "" or hit[s] == true
		if q ~= "" and hit[s] and not s.IsOpen then s:SetOpen(true) end
	end
end

