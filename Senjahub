local notifHolder, notifN, notifActive = nil, 0, {}
local KindCol = {success = C3(112,196,140), warn = C3(234,186,92), error = C3(232,100,108)}
local KindIcon = {success = "check", warn = "warn", error = "x", info = "info"}

local function getNotif()
	if notifHolder and notifHolder.Parent then return notifHolder end
	local g = new("ScreenGui", {Name = "SenjaNotif", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 1001, ZIndexBehavior = E.ZIndexBehavior.Sibling})
	mount(g)
	notifHolder = new("Frame", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 46), Size = UDim2.new(0, 272, 1, -60), Parent = g})
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = E.SortOrder.LayoutOrder, Parent = notifHolder})
	return notifHolder
end

local function wrapped(p, text, sz, key, w)
	local l = label(p, text, sz, key, w)
	l.TextWrapped, l.AutomaticSize, l.Size = true, AY, UDim2.new(1, 0, 0, 0)
	return l
end

function Senja:Notify(o)
	if type(o) == "string" then o = {Content = o} end
	task.spawn(function()
		local hold = getNotif()
		local kind = o.Type or "info"
		local title, body = o.Title, o.Content
		if not title then title, body = body or "Notifikasi", nil end
		local dur = o.Duration or 4
		local key = kind .. "|" .. tostring(title) .. "|" .. tostring(body)

		-- pesan yang sama: tambah hitungan, ulang timer, goyang sedikit
		for _, e in ipairs(notifActive) do
			if e.key == key and not e.closed then
				e.count += 1
				e.left = dur
				e.title.Text = title .. "  x" .. e.count
				if not e.drag then
					e.card.Position = UDim2.fromOffset(-5, 0)
					tw(e.card, {Position = UDim2.new()}, .2)
				end
				return
			end
		end

		notifN += 1
		local col = KindCol[kind]
		local wrap = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = notifN, Parent = hold})
		local card = new("CanvasGroup", {Active = true, Position = UDim2.fromOffset(300, 0), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY,
			GroupTransparency = 1, Parent = wrap})
		bind(card, "BackgroundColor3", "Surface") corner(card, 7) stroke(card, "Stroke", 1, 0) pad(card, 12, 10, 12, 11)
		local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = card})

		local src = Senja.Icon(KindIcon[kind] or "info")
		if src ~= "" then
			local ic = new("ImageLabel", {BackgroundTransparency = 1, Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(0, 1), Image = src, Parent = row})
			if col then ic.ImageColor3 = col else bind(ic, "ImageColor3", "Accent") end
		else
			local dot = new("Frame", {Size = UDim2.fromOffset(7, 7), Position = UDim2.fromOffset(3, 5), Parent = row})
			corner(dot, 4)
			if col then dot.BackgroundColor3 = col else bind(dot, "BackgroundColor3", "Accent") end
		end
		local txt = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(24, 0), Size = UDim2.new(1, -24, 0, 0), AutomaticSize = AY, Parent = row})
		new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = E.SortOrder.LayoutOrder, Parent = txt})
		local tl = wrapped(txt, title, 13, "Text", E.FontWeight.SemiBold)
		tl.LayoutOrder = 1
		if body then wrapped(txt, body, 12, "Sub").LayoutOrder = 2 end

		local e = {key = key, card = card, title = tl, count = 1, left = dur, closed = false, drag = false}
		notifActive[#notifActive + 1] = e
		local conns = {}

		local function close()
			if e.closed then return end
			e.closed = true
			local i = table.find(notifActive, e)
			if i then table.remove(notifActive, i) end
			tw(card, {Position = UDim2.fromOffset(300, 0), GroupTransparency = 1}, .2)
			task.wait(.16)
			if not wrap.Parent then return end
			wrap.AutomaticSize = E.AutomaticSize.None
			wrap.Size = UDim2.new(1, 0, 0, wrap.AbsoluteSize.Y)
			wrap.ClipsDescendants = true
			tw(wrap, {Size = UDim2.new(1, 0, 0, 0)}, .16)
			task.wait(.18)
			for _, c in ipairs(conns) do c:Disconnect() end
			wrap:Destroy()
		end
		e.close = close

		local inT = tw(card, {Position = UDim2.new(), GroupTransparency = 0}, .28)

		-- batas jumlah
		while #notifActive > 5 do
			local old = notifActive[1]
			if old == e then break end
			task.spawn(old.close)
		end

		-- timer, berhenti selama disorot atau diseret
		local hover = false
		card.MouseEnter:Connect(function() hover = true end)
		card.MouseLeave:Connect(function() hover = false end)
		task.spawn(function()
			while not e.closed do
				local dt = RunService.Heartbeat:Wait()
				if not (hover or e.drag) then e.left -= dt end
				if e.left <= 0 then close() break end
			end
		end)

		-- ketuk = tutup (menjalankan Callback bila ada), seret ke kanan = singkirkan
		local x0, dx, lt, vel = 0, 0, 0, 0
		card.InputBegan:Connect(function(i)
			if e.closed or e.drag then return end
			if i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch then
				inT:Cancel()
				e.drag, x0, dx, lt, vel = true, i.Position.X, 0, os.clock(), 0
			end
		end)
		conns[#conns + 1] = UIS.InputChanged:Connect(function(i)
			if not e.drag then return end
			if i.UserInputType ~= E.UserInputType.MouseMovement and i.UserInputType ~= E.UserInputType.Touch then return end
			local nx, now = i.Position.X - x0, os.clock()
			vel = vel * .6 + ((nx - dx) / math.max(now - lt, .001)) * .4
			dx, lt = nx, now
			local px = dx > 0 and dx or dx * .25
			card.Position = UDim2.fromOffset(px, 0)
			card.GroupTransparency = math.clamp(px / 280, 0, .7)
		end)
		conns[#conns + 1] = UIS.InputEnded:Connect(function(i)
			if not e.drag then return end
			if i.UserInputType ~= E.UserInputType.MouseButton1 and i.UserInputType ~= E.UserInputType.Touch then return end
			e.drag = false
			if math.abs(dx) < 5 then
				if o.Callback then safe(o.Callback) end
				task.spawn(close)
			elseif dx > 80 or vel > 700 then
				task.spawn(close)
			else
				tw(card, {Position = UDim2.new(), GroupTransparency = 0}, .2)
			end
		end)
	end)
end

