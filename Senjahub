local function tw(o, p, t, s, d)
	local tr = TweenService:Create(o, TweenInfo.new((t or .16) * Senja.Speed, s or Q, d or OUT), p)
	tr:Play()
	return tr
end

local function bind(o, p, k)
	Reg[#Reg + 1] = {o, p, k}
	o[p] = Cur[k]
	return o
end

local AccentOverride
local function lum(c) return .299 * c.R + .587 * c.G + .114 * c.B end
local function applyTheme(tbl, name)
	CurName, Cur = name, tbl
	local alive = {}
	for _, r in ipairs(Reg) do
		if r[1].Parent then alive[#alive + 1] = r tw(r[1], {[r[2]] = Cur[r[3]]}, .25) end
	end
	Reg = alive
	for _, f in ipairs(Hooks) do pcall(f) end
end
function Senja:AddTheme(name, t)
	if not Themes[name] then Order[#Order + 1] = name end
	Themes[name] = t
end
function Senja:GetThemes() local n = {} for i, k in ipairs(Order) do n[i] = k end return n end
function Senja:GetTheme() return Cur, CurName end
function Senja:OnTheme(f) Hooks[#Hooks + 1] = f end
function Senja:SetTheme(n)
	if not Themes[n] then return end
	AccentOverride = nil
	applyTheme(Themes[n], n)
end
function Senja:SetAccent(c)
	local t = {}
	for k, v in pairs(Themes[CurName]) do t[k] = v end
	t.Accent = c
	t.OnAccent = lum(c) > .6 and C3(20, 18, 16) or WHITE
	AccentOverride = c
	applyTheme(t, CurName)
end
function Senja:GetAccentOverride() return AccentOverride end

