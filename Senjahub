-- ikon senja "tenggelam lalu terbit": turun sedikit dan mengecil, naik sambil membesar, lalu kembali normal.
-- hanya properti Position dan UIScale yang dianimasikan, jadi ringan.
local breathing = {}
local function breathe(ic, us)
	if breathing[ic] or not ic.Parent then return end
	breathing[ic] = true
	local home = ic.Position
	local function at(dy) return UDim2.new(home.X.Scale, home.X.Offset, home.Y.Scale, home.Y.Offset + dy) end
	local IO = E.EasingDirection.InOut
	task.spawn(function()
		tw(ic, {Position = at(4)}, .3, Sine, IO)
		tw(us, {Scale = .86}, .3, Sine, IO).Completed:Wait()
		if ic.Parent then
			tw(ic, {Position = at(-3)}, .34, Qn)
			tw(us, {Scale = 1.22}, .34, Qn).Completed:Wait()
		end
		if ic.Parent then
			tw(ic, {Position = home}, .4, Sine, IO)
			tw(us, {Scale = 1}, .4, Sine, IO).Completed:Wait()
		end
		breathing[ic] = nil
	end)
end

-- gestur tarik ke atas dari garis di bawah window untuk menutup.
-- window ikut jari/kursor; lepas setelah cukup jauh atau cukup cepat -> tertutup, kalau tidak -> kembali.
local function swipeClose(win, zone)
	local on = false
	local function span() return math.clamp(workspace.CurrentCamera.ViewportSize.Y * .45, 200, 380) end
	zone.InputBegan:Connect(function(i)
		if not isPtr(i) or on then return end
		on = true
		local y0, last, lt, vel, over = i.Position.Y, i.Position.Y, os.clock(), 0, false
		win._tok += 1
		win:_stop()
		ptrDrag(function(m)
			local y, now = m.Position.Y, os.clock()
			vel = vel * .6 + ((y - last) / math.max(now - lt, .001)) * .4
			last, lt = y, now
			local p = 1 - math.clamp(-(y - y0) / span(), 0, 1)
			win:_progress(p)
			local nowOver = p < .65
			if nowOver ~= over then win:_grabFx(nowOver) end
			over = nowOver
		end, function()
			on = false
			win:_grabFx(false)
			win:Toggle(not (over or vel < -900))
		end)
	end)
end

