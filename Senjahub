-- latar utama: video loop "Samurai Autumn" (10 detik, hitam-putih, tanpa suara) yang diputar lewat VideoFrame
-- di belakang UI. video sudah tertanam di akhir file (Senja.BgData, base64). saat pertama jalan video ditulis ke
-- Senja/assets/bg_v1.webm lalu dipakai dari file itu, jadi pemuatan berikutnya cepat.
-- mau pakai video sendiri? taruh bg.webm atau bg.mp4 di folder Senja (workspace/Senja), itu didahulukan.
--
-- kalau video tidak bisa diputar (executor tanpa writefile / getcustomasset, atau tidak mendukung VideoFrame),
-- otomatis memakai animasi bawaan yang meniru suasananya, semuanya digerakkan tween (tanpa callback per frame):
--   1. bulan: cahaya besar lembut + cakram kecil yang "bernapas" pelan (warna mengikuti aksen tema)
--   2. kabut: tiga cahaya lebar yang melayang pelan di bagian bawah dan tengah
--   3. bintang: titik kecil di bagian atas yang berkelip
--   4. daun: potongan kecil yang jatuh miring tertiup angin sambil berputar dan bergoyang
-- bulan dan kabut butuh writefile + getcustomasset; kalau tidak ada, lapisan itu dilewati.
local function glowPng(n)
	local px = {}
	local c = (n - 1) / 2
	for y = 0, n - 1 do
		for x = 0, n - 1 do
			local d = math.sqrt((x - c) ^ 2 + (y - c) ^ 2) / (n / 2)
			local a = math.clamp(1 - d, 0, 1)
			a = a * a * (3 - 2 * a)
			local i = (y * n + x) * 4
			px[i + 1], px[i + 2], px[i + 3], px[i + 4] = 255, 255, 255, math.floor(a * 255 + .5)
		end
	end
	return png(n, n, px)
end

-- base64 -> string biner (untuk video tertanam)
local B64CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function b64decode(s)
	local map = {}
	for i = 1, 64 do map[B64CHARS:byte(i)] = i - 1 end
	s = s:gsub("[^%w%+/=]", "")
	local out, n = {}, 0
	for i = 1, #s, 4 do
		local a, b, c, d = s:byte(i, i + 3)
		local v = map[a] * 262144 + map[b] * 4096 + (map[c] or 0) * 64 + (map[d] or 0)
		local b1, b2, b3 = math.floor(v / 65536) % 256, math.floor(v / 256) % 256, v % 256
		n += 1
		if c == 61 then out[n] = string.char(b1)
		elseif d == 61 then out[n] = string.char(b1, b2)
		else out[n] = string.char(b1, b2, b3) end
	end
	return table.concat(out)
end

local BG_CACHE = Senja.Folder .. "/assets/bg_v1.webm"
-- cari file video yang bisa dipakai: video buatan sendiri dulu, lalu klip bawaan (ditulis dari data tertanam)
local function resolveVideo()
	if not (isfile and writefile and getasset) then return nil end
	for _, p in ipairs({Senja.Folder .. "/bg.webm", Senja.Folder .. "/bg.mp4"}) do
		local ok, has = pcall(isfile, p)
		if ok and has then return p end
	end
	local ok, has = pcall(isfile, BG_CACHE)
	if ok and has then return BG_CACHE end
	-- data tertanam ada di akhir file, jadi tunggu sebentar sampai terdefinisi
	local t0 = os.clock()
	while not Senja.BgData and os.clock() - t0 < 4 do task.wait(.1) end
	if not Senja.BgData then return nil end
	local good = pcall(function()
		if makefolder and isfolder then
			if not isfolder(Senja.Folder) then makefolder(Senja.Folder) end
			if not isfolder(Senja.Folder .. "/assets") then makefolder(Senja.Folder .. "/assets") end
		end
		writefile(BG_CACHE, b64decode(Senja.BgData))
	end)
	Senja.BgData = nil
	return good and BG_CACHE or nil
end

local function buildBgFx(parent)
	local fx = {Tweens = {}, Run = false, Mode = "proc"}
	local root = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent})
	fx.Frame = root
	-- semua animasi bawaan ada di dalam proc, jadi bisa disembunyikan sekaligus kalau video yang dipakai
	local proc = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root})
	local IO = E.EasingDirection.InOut
	local rng = Random.new()
	local src = asset("v1_glow", function() return glowPng(64) end)
	local vid, shade

	-- tween bolak-balik tanpa henti; semuanya dicatat supaya bisa dijeda saat UI tertutup / diminimalkan
	local function loop(inst, props, t)
		local tr = TweenService:Create(inst, TweenInfo.new(t, Sine, IO, -1, true), props)
		fx.Tweens[#fx.Tweens + 1] = tr
		return tr
	end
	local function glow(size, pos, tr, key)
		local im = new("ImageLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Size = size, Position = pos,
			Image = src, ImageTransparency = tr, Parent = proc})
		return bind(im, "ImageColor3", key)
	end

	-- 1. bulan
	local moonPos = UDim2.fromScale(.8, .24)
	if src ~= "" then
		local halo = glow(UDim2.fromOffset(300, 300), moonPos, .72, "Accent")
		loop(halo, {Size = UDim2.fromOffset(340, 340), ImageTransparency = .8}, 7)
	end
	local disc = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(84, 84), Position = moonPos, BackgroundTransparency = .8, Parent = proc})
	bind(disc, "BackgroundColor3", "Accent") corner(disc, 42)
	loop(disc, {BackgroundTransparency = .88}, 7)

	-- 2. kabut
	if src ~= "" then
		local fog = {
			{y = .86, w = 520, h = 140, a = .28, b = .62, t = 16, tr = .88},
			{y = .62, w = 440, h = 120, a = .70, b = .38, t = 20, tr = .90},
			{y = .40, w = 380, h = 110, a = .25, b = .55, t = 24, tr = .92},
		}
		for _, f in ipairs(fog) do
			local im = glow(UDim2.fromOffset(f.w, f.h), UDim2.fromScale(f.a, f.y), f.tr, "Text")
			loop(im, {Position = UDim2.fromScale(f.b, f.y)}, f.t)
		end
	end

	-- 3. bintang berkelip
	for _ = 1, 18 do
		local s = rng:NextInteger(1, 2)
		local st = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(s, s),
			Position = UDim2.fromScale(rng:NextNumber(.03, .97), rng:NextNumber(.03, .5)), BackgroundTransparency = rng:NextNumber(.35, .6), Parent = proc})
		bind(st, "BackgroundColor3", "Text") corner(st, 1)
		loop(st, {BackgroundTransparency = .95}, rng:NextNumber(1.4, 3.6))
	end

	-- 4. daun tertiup angin: jatuh miring ke kanan, bergoyang, berputar, memudar masuk lalu keluar.
	-- tiap daun hanya "bangun" sekali per putaran (sekitar 9-16 detik).
	for _ = 1, 12 do
		local w, h = rng:NextInteger(5, 8), rng:NextInteger(2, 3)
		local holder = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromOffset(0, 0), Parent = proc})
		local leaf = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Size = UDim2.fromOffset(w, h), BackgroundTransparency = 1, Parent = holder})
		bind(leaf, "BackgroundColor3", "Text") corner(leaf, 2)
		task.spawn(function()
			task.wait(rng:NextNumber(0, 10))
			while root.Parent do
				if fx.Run and fx.Mode == "proc" then
					local x0, d = rng:NextNumber(-.1, .7), rng:NextNumber(9, 16)
					local dirS = rng:NextInteger(0, 1) * 2 - 1
					holder.Position = UDim2.fromScale(x0, -.04)
					leaf.Position = UDim2.fromOffset(0, 0)
					leaf.Rotation = rng:NextNumber(0, 180)
					leaf.BackgroundTransparency = 1
					local fall = TweenService:Create(holder, TweenInfo.new(d, Lin), {Position = UDim2.fromScale(x0 + rng:NextNumber(.25, .45), 1.04)})
					local sway = TweenService:Create(leaf, TweenInfo.new(d / 6, Sine, IO, 5, true), {Position = UDim2.fromOffset(rng:NextInteger(10, 22) * dirS, 0)})
					local spin = TweenService:Create(leaf, TweenInfo.new(d, Lin), {Rotation = leaf.Rotation + rng:NextNumber(180, 540) * dirS})
					local fade = TweenService:Create(leaf, TweenInfo.new(d / 2, Sine, IO, 1, true), {BackgroundTransparency = rng:NextNumber(.35, .6)})
					fall:Play() sway:Play() spin:Play() fade:Play()
					fall.Completed:Wait()
				else
					task.wait(.5)
				end
			end
		end)
	end

	-- terapkan keadaan: video atau animasi bawaan, jalan atau dijeda
	function fx:Apply()
		local on, isVid = self.Run, self.Mode == "video"
		root.Visible = on
		proc.Visible = not isVid
		for _, t in ipairs(self.Tweens) do
			if on and not isVid then t:Play() else t:Pause() end
		end
		if vid then
			vid.Visible, shade.Visible = isVid, isVid
			if on and isVid then vid:Play() else vid:Pause() end
		end
	end
	function fx:Set(on)
		on = on and true or false
		if self.Run == on then return end
		self.Run = on
		self:Apply()
	end

	-- video: disiapkan di belakang layar; kalau berhasil dimuat, menggantikan animasi bawaan
	task.spawn(function()
		local path = resolveVideo()
		if not path or not root.Parent then return end
		-- diberi jarak 6px dari tepi supaya sudut persegi video tidak keluar dari sudut bulat window
		local v = new("VideoFrame", {Size = UDim2.new(1, -12, 1, -12), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 1,
			Looped = true, Volume = 0, Visible = false, Parent = root})
		if not pcall(function() v.Video = getasset(path) end) then v:Destroy() return end
		local t0 = os.clock()
		while v.Parent and not v.IsLoaded and os.clock() - t0 < 10 do task.wait(.2) end
		if not (v.Parent and v.IsLoaded) then v:Destroy() return end
		-- lapisan gelap tipis supaya teks UI tetap mudah dibaca di atas video yang terang
		local sh = new("Frame", {BackgroundColor3 = BLACK, BackgroundTransparency = .5, Size = v.Size, Position = v.Position, Visible = false, Parent = root})
		vid, shade = v, sh
		fx.Mode = "video"
		fx:Apply()
	end)

	return fx
end

