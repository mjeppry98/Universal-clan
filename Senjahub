function Box:AddSlider(o)
	local c = self:_row(o, 62)
	local mn, mx, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local obj = {Type = "Slider", Value = mn}
	local vb = new("TextBox", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(54, 20), Text = "",
		ClearTextOnFocus = false, TextSize = 12, FontFace = font(E.FontWeight.SemiBold), Parent = c.row})
	bind(vb, "BackgroundColor3", "Bg") bind(vb, "TextColor3", "Accent") corner(vb, 3)
	local barh = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Active = true, Parent = c.col})
	local track = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 0, 0, 15), Size = UDim2.new(1, 0, 0, 4), Parent = barh})
	bind(track, "BackgroundColor3", "Track") corner(track, 2)
	local fill = new("Frame", {Size = UDim2.fromScale(0, 1), Parent = track})
	bind(fill, "BackgroundColor3", "Accent") corner(fill, 2)
	local mark = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(3, 12), Parent = fill})
	bind(mark, "BackgroundColor3", "Text") corner(mark, 1)
	local bub = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(0, 0, 0, 9), Size = UDim2.fromOffset(46, 18), Parent = barh})
	bind(bub, "BackgroundColor3", "Accent") corner(bub, 3)
	bub.BackgroundTransparency = 1
	local bl = label(bub, "", 11, "OnAccent", E.FontWeight.SemiBold)
	bl.Size, bl.TextXAlignment, bl.TextTransparency = UDim2.fromScale(1, 1), E.TextXAlignment.Center, 1
	local function showBub(on)
		tw(bub, {BackgroundTransparency = on and 0 or 1}, .1)
		tw(bl, {TextTransparency = on and 0 or 1}, .1)
		tw(mark, {Size = UDim2.fromOffset(on and 5 or 3, on and 16 or 12)}, .1)
	end
	function obj:Set(v, silent)
		v = math.clamp(math.floor(((tonumber(v) or mn) - mn) / inc + .5) * inc + mn, mn, mx)
		self.Value = v
		local r = mx > mn and (v - mn) / (mx - mn) or 0
		tw(fill, {Size = UDim2.fromScale(r, 1)}, .08)
		local txt = tostring(math.floor(v * 100 + .5) / 100) .. (o.Suffix or "")
		vb.Text, bl.Text = txt, txt
		tw(bub, {Position = UDim2.new(math.clamp(r, .08, .92), 0, 0, 9)}, .08)
		if not silent then safe(o.Callback, v) end
	end
	function obj:Get() return self.Value end
	function obj:Serialize() return self.Value end
	dragger(self.Win, barh, function(p)
		obj:Set(mn + (mx - mn) * math.clamp((p.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1))
	end, function() showBub(true) self:_lock(true) end, function() showBub(false) self:_lock(false) end)
	vb.FocusLost:Connect(function() obj:Set(tonumber(vb.Text:match("-?[%d%.]+")) or obj.Value) end)
	obj:Set(o.Default or mn, true)
	return reg(o, obj)
end

