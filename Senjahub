-- minimize: window mengecil jadi header saja. klik lagi untuk memulihkan.
-- bilah tab, halaman (tombol, slider, dll), footer, dan garis tarik disembunyikan LANGSUNG saat minimize,
-- bukan menunggu animasi mengecil selesai. kalau menunggu, isinya terlihat tersapu sebentar sebelum hilang.
function Window:SetMinimized(v)
	v = v and true or false
	if self.Minimized == v then return end
	self.Minimized = v
	if openDD then openDD:Close() end
	self.NavFrame.Visible, self.Pages.Visible, self.Foot.Visible, self.Grab.Visible = not v, not v, not v, not v
	tw(self.Main, {Size = v and UDim2.new(1, 0, 0, 52) or UDim2.fromScale(1, 1)}, .26, Qn)
	tw(self.MainCorner, {CornerRadius = UDim.new(0, v and 26 or 20)}, .26, Qn)
	if self.Open then tw(self.Dim, {BackgroundTransparency = self:_dimT()}, .2) end
	self.MinIcon.Image = Senja.Icon(v and "chevron" or "minus")
	self:_fxSync()
end
function Window:Minimize() self:SetMinimized(not self.Minimized) end

function Window:ResetPos()
	self.Home = UDim2.fromScale(.5, .5)
	pref("wx", nil) pref("wy", nil)
	if self.Open then
		self:_stop()
		tw(self.Root, {Position = self.Home}, .24, Qn)
	end
end

function Window:Destroy()
	pcall(function() self:_autoSave() end)
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	self._tok += 1
	self.Open = false
	self:_fxSync()
	if self.Fab then self.Fab.Visible = false end
	self:_go(false)
	local i = table.find(Senja.Windows, self)
	if i then table.remove(Senja.Windows, i) end
	task.delay(.3, function() self.Gui:Destroy() end)
end

-- ukuran window mengikuti ukuran layar dan skala UI (supaya tidak melebihi layar saat diputar atau skala 130%)
function Window:_fit()
	local v = workspace.CurrentCamera.ViewportSize
	local k = self.UserScale
	self.Root.Size = UDim2.fromOffset(math.min(self.BaseSize.X, (v.X - 24) / k), math.min(self.BaseSize.Y, (v.Y - 24) / k))
	self:_clamp()
	if not self.Open then
		local _, cy = self:_px()
		self:_at(cy)
	end
end

-- jaga supaya header tidak pernah keluar layar (kalau keluar, window tidak bisa dijangkau lagi)
function Window:_clamp()
	local v = workspace.CurrentCamera.ViewportSize
	local k = self.UserScale
	local w, h = self.Root.Size.X.Offset * k, self.Root.Size.Y.Offset * k
	local cx = self.Home.X.Scale * v.X + self.Home.X.Offset
	local cy = self.Home.Y.Scale * v.Y + self.Home.Y.Offset
	local xlo, xhi = 120 - w / 2, v.X - 120 + w / 2
	if xlo > xhi then xlo = xhi end
	local nx = math.clamp(cx, xlo, xhi)
	local ny = math.clamp(cy, h / 2, math.max(h / 2, v.Y - 60 + h / 2))
	if nx ~= cx or ny ~= cy then
		self.Home = UDim2.new(self.Home.X.Scale, self.Home.X.Offset + (nx - cx), self.Home.Y.Scale, self.Home.Y.Offset + (ny - cy))
		if self.Open then
			self:_stop()
			tw(self.Root, {Position = self.Home}, .2, Qn)
		end
		return true
	end
end

function Window:Show() self:Toggle(true) end
function Window:Hide() self:Toggle(false) end
function Window:IsOpen() return self.Open end
function Window:SetTitle(t) self.TitleLabel.Text = tostring(t) end
function Window:SetSubtitle(t) self.SubLabel.Text = tostring(t) end

-- pilih tab dari objek tab, nomor urut, atau judulnya
function Window:SelectTab(x)
	local tab = x
	if type(x) == "number" then
		tab = self.Tabs[x]
	elseif type(x) == "string" then
		tab = nil
		for _, t in ipairs(self.Tabs) do
			if t.Title == x then tab = t break end
		end
	end
	if tab then self:Select(tab) end
	return tab
end

function Window:Confirm(title, content, onYes, onNo)
	self:Dialog({Title = title, Content = content, Buttons = {{Title = "Batal", Callback = onNo}, {Title = "Ya", Primary = true, Callback = onYes}}})
end

-- pindah tab: halaman lama langsung disembunyikan, halaman baru menggeser masuk dari arah yang sama dengan indikator
function Window:Select(tab)
	if self.Current == tab then return end
	if openDD then openDD:Close() end
	local old = self.Current
	self.Current = tab
	if not tab.IsSettings then self.LastTab = tab end
	local dir = (old and old.Index > tab.Index) and -1 or 1
	if old then
		old._paint(false)
		old.Group.Visible = false
	end
	tab._paint(true)
	tab.Group.Position, tab.Group.Visible = UDim2.fromOffset(0, 24 * dir), true
	if tab._tw then tab._tw:Cancel() end
	tab._tw = tw(tab.Group, {Position = UDim2.new()}, .22, Qn)
	self:_moveInd(old ~= nil)
	self:_filter(self.SearchBox.Text)
	local pg = self:_page(tab)
	for _, s in ipairs(pg.Secs) do s.Refresh() end
	task.defer(function() for _, s in ipairs(pg.Secs) do s.Refresh() end end)
end

-- saring baris berdasarkan kata kunci. section tanpa hasil disembunyikan,
-- section tertutup yang punya hasil dibuka otomatis.
function Window:_filter(q)
	q = q:lower()
	local tab = self:_page(self.Current)
	if not tab then return end
	local hit = {}
	for _, it in ipairs(tab.Items) do
		local hay = (it.title .. " " .. (it.desc or "")):lower()
		local ok = q == "" or hay:find(q, 1, true) ~= nil
		it.holder.Visible = ok and not it.hidden
		if ok and not it.hidden then hit[it.box] = true end
	end
	for _, s in ipairs(tab.Secs) do
		s.Frame.Visible = q == "" or hit[s] == true
		if q ~= "" and hit[s] and not s.IsOpen then s:SetOpen(true) end
	end
end

-- tombol tab disusun menurun di rail kiri; indikator bergeser naik-turun di antaranya.
-- kalau tab banyak, rail bisa digulir.
function Window:_layoutTabs()
	local n = #self.Tabs
	for i, t in ipairs(self.Tabs) do
		t.Index = i
		t.Btn.Size = UDim2.new(1, 0, 0, TABH)
		t.Btn.Position = UDim2.fromOffset(0, (i - 1) * (TABH + TABP))
	end
	self.Ind.Size = UDim2.new(1, 0, 0, TABH)
	self.Nav.CanvasSize = UDim2.fromOffset(0, math.max(0, n * (TABH + TABP) - TABP))
	self:_moveInd(false)
end
function Window:_moveInd(anim)
	local t = self.Current
	if not t then return end
	-- halaman pengaturan tidak ada di bilah tab, jadi indikator disembunyikan
	if t.IsSettings then
		tw(self.Ind, {BackgroundTransparency = 1}, .12)
		return
	end
	local pos = UDim2.fromOffset(0, (t.Index - 1) * (TABH + TABP))
	local hidden = self.Ind.BackgroundTransparency > .5
	self.Ind.Visible = true
	if anim and not hidden then tw(self.Ind, {Position = pos}, .26, Qn) else self.Ind.Position = pos end
	tw(self.Ind, {BackgroundTransparency = 0}, .12)
end

-- halaman berupa Frame biasa (bukan CanvasGroup) supaya tidak ada render ke tekstur tiap frame
function Window:_newPage(parent)
	local grp = new("Frame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent or self.Pages})
	local sc = new("ScrollingFrame", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), AutomaticCanvasSize = AY,
		CanvasSize = UDim2.new(), ScrollBarThickness = 3, ScrollBarImageTransparency = .4, Parent = grp})
	bind(sc, "ScrollBarImageColor3", "Track")
	-- UIPadding langsung di ScrollingFrame ikut memotong area gulir (bagian bawah dan atas jadi terpotong),
	-- jadi layout + padding dipindah ke frame isi di dalamnya
	local body = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = sc})
	new("UIListLayout", {Padding = UDim.new(0, 12), SortOrder = E.SortOrder.LayoutOrder, Parent = body})
	pad(body, 14, 8, 14, 20)
	local tab = newBox(self, nil, body)
	tab.Tab, tab.Items, tab.Group, tab.Secs, tab.Scroll = tab, {}, grp, {}, sc
	return tab
end

-- halaman aktif sebuah tab: kalau tab punya sub tab, halamannya adalah sub tab yang sedang dipilih
function Window:_page(t)
	return t and (t.Sub or t)
end

-- sub tab: bar kecil di atas halaman tab. tiap sub tab punya halaman dan scroll sendiri di bawah bar.
-- semua tombol sub tab berbagi lebar sama; indikator bergeser di antaranya.
function Window:_layoutSubs(tab)
	local n = #tab.Subs
	for i, s in ipairs(tab.Subs) do
		s.Index = i
		s.Btn.Size = UDim2.new(1 / n, 0, 1, 0)
		s.Btn.Position = UDim2.new((i - 1) / n, 0, 0, 0)
	end
	tab.SubInd.Size = UDim2.new(1 / n, -4, 1, 0)
	self:_moveSubInd(tab, false)
end
function Window:_moveSubInd(tab, anim)
	local s = tab.Sub
	if not s then return end
	local pos = UDim2.new((s.Index - 1) / #tab.Subs, 2, 0, 0)
	tab.SubInd.Visible = true
	if anim then tw(tab.SubInd, {Position = pos}, .26, Qn) else tab.SubInd.Position = pos end
end
function Window:_selectSub(tab, sub)
	if tab.Sub == sub then return end
	if openDD then openDD:Close() end
	local old = tab.Sub
	tab.Sub = sub
	local dir = (old and old.Index > sub.Index) and -1 or 1
	if old then
		old._paint(false)
		old.Group.Visible = false
	end
	sub._paint(true)
	sub.Group.Position, sub.Group.Visible = UDim2.fromOffset(24 * dir, 0), true
	if sub._tw then sub._tw:Cancel() end
	sub._tw = tw(sub.Group, {Position = UDim2.new()}, .22, Qn)
	self:_moveSubInd(tab, old ~= nil)
	if self.Current == tab then
		self:_filter(self.SearchBox.Text)
		for _, s in ipairs(sub.Secs) do s.Refresh() end
		task.defer(function() for _, s in ipairs(sub.Secs) do s.Refresh() end end)
	end
end
function Window:_addSub(tab, o)
	if type(o) == "string" then o = {Title = o} end
	local win = self
	if not tab.SubBar then
		-- sub tab pertama: siapkan bar di atas dan wadah halaman di bawahnya, halaman utama tab disembunyikan
		tab.Scroll.Visible = false
		tab.Subs = {}
		local bar = new("Frame", {Position = UDim2.fromOffset(14, 6), Size = UDim2.new(1, -28, 0, SUBH), Parent = tab.Group})
		bind(bar, "BackgroundColor3", "Side") corner(bar, SUBH / 2) glass(bar)
		local inner = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(3, 3), Size = UDim2.new(1, -6, 1, -6), Parent = bar})
		local ind = new("Frame", {Visible = false, Size = UDim2.new(1, -4, 1, 0), Parent = inner})
		bind(ind, "BackgroundColor3", "Track") corner(ind, (SUBH - 6) / 2)
		local host = new("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.fromOffset(0, SUBH + 10),
			Size = UDim2.new(1, 0, 1, -(SUBH + 10)), Parent = tab.Group})
		tab.SubBar, tab.SubInner, tab.SubInd, tab.SubHost = bar, inner, ind, host
	end
	local btn = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, ZIndex = 2, Parent = tab.SubInner})
	local lb = label(btn, o.Title or "Sub", 12, "Sub", E.FontWeight.SemiBold)
	lb.Size, lb.TextXAlignment, lb.TextTruncate = UDim2.fromScale(1, 1), E.TextXAlignment.Center, E.TextTruncate.AtEnd
	local sub = self:_newPage(tab.SubHost)
	sub.Btn, sub.Lb, sub.Title, sub.Owner = btn, lb, o.Title or "Sub", tab
	sub._paint = function(sel, inst)
		tw(lb, {TextColor3 = sel and Cur.Text or Cur.Sub}, inst and 0 or .12)
	end
	btn.MouseEnter:Connect(function() if tab.Sub ~= sub then tw(lb, {TextColor3 = Cur.Text}, .08) end end)
	btn.MouseLeave:Connect(function() if tab.Sub ~= sub then tw(lb, {TextColor3 = Cur.Sub}, .12) end end)
	btn.MouseButton1Click:Connect(function() win:_selectSub(tab, sub) end)
	Hooks[#Hooks + 1] = function() sub._paint(tab.Sub == sub, true) end
	table.insert(tab.Subs, sub)
	self:_layoutSubs(tab)
	if #tab.Subs == 1 then self:_selectSub(tab, sub) end
	return sub
end
-- hanya bisa dipanggil dari tab (hasil Win:AddTab), bukan dari section atau sub tab
function Box:AddSubTab(o)
	assert(self.Tab == self and not self.Owner, "[Senja] AddSubTab hanya bisa dipanggil dari tab, bukan dari section atau sub tab")
	return self.Win:_addSub(self, o)
end

-- latar beranimasi hanya jalan saat UI terbuka, tidak diminimalkan, dan fiturnya menyala.
-- selain itu animasinya dijeda dan lapisannya disembunyikan, jadi tidak ada beban.
function Window:_fxSync()
	if self.Fx then self.Fx:Set(self.BgFx and self.Open and not self.Minimized) end
end
function Window:SetBgFx(on)
	on = on and true or false
	self.BgFx = on
