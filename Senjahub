local function cfgPath(n) return Senja.Folder .. "/configs/" .. n .. ".json" end
function Window:SaveConfig(name)
	if not writefile then return false end
	name = tostring(name or "default"):gsub("[^%w_%-]", "")
	pcall(makefolder, Senja.Folder) pcall(makefolder, Senja.Folder .. "/configs")
	local d = {__theme = CurName}
	if AccentOverride then
		d.__accent = string.format("#%02X%02X%02X", math.floor(AccentOverride.R * 255 + .5), math.floor(AccentOverride.G * 255 + .5), math.floor(AccentOverride.B * 255 + .5))
	end
	for f, ob in pairs(Senja.Flags) do if ob.Serialize then d[f] = ob:Serialize() end end
	writefile(cfgPath(name), HttpService:JSONEncode(d))
	return true
end
function Window:LoadConfig(name)
	if not (readfile and isfile) or not isfile(cfgPath(name)) then return false end
	local ok, d = pcall(function() return HttpService:JSONDecode(readfile(cfgPath(name))) end)
	if not ok then return false end
	if d.__theme then Senja:SetTheme(d.__theme) end
	if d.__accent then
		local r, g, b = tostring(d.__accent):match("^#?(%x%x)(%x%x)(%x%x)$")
		if r then Senja:SetAccent(C3(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))) end
	end
	for f, v in pairs(d) do
		local ob = Senja.Flags[f]
		if ob and ob.Set then pcall(ob.Set, ob, v) end
	end
	return true
end
function Window:ListConfigs()
	local r = {}
	if listfiles and isfolder and isfolder(Senja.Folder .. "/configs") then
		for _, p in ipairs(listfiles(Senja.Folder .. "/configs")) do
			local n = p:match("([^/\\]+)%.json$")
			if n then r[#r + 1] = n end
		end
	end
	return r
end

