function Box:AddToggle(o)
	local c = self:_row(o, 46, true)
	local obj = {Type = "Toggle", Value = false}
	local pressed = false
	local track = new("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(40, 22), Parent = c.row})
	bind(track, "BackgroundColor3", "Track") corner(track, 11)
	local knob = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 3, .5, 0), Size = UDim2.fromOffset(16, 16), Parent = track})
	bind(knob, "BackgroundColor3", "Sub") corner(knob, 8)
	local hit = new("TextButton", {BackgroundTransparency = 1, Text = "", AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 2, .5, 0),
		Size = UDim2.fromOffset(44, 28), ZIndex = 5, Parent = c.row})
	local function paint(inst)
		local t = inst and 0 or .16
		local w = pressed and 21 or 16
		tw(track, {BackgroundColor3 = obj.Value and Cur.Accent or Cur.Track}, inst and 0 or .14)
		tw(knob, {Size = UDim2.fromOffset(w, 16), Position = UDim2.new(0, obj.Value and (37 - w) or 3, .5, 0),
			BackgroundColor3 = obj.Value and Cur.OnAccent or Cur.Sub}, t, Qn)
	end
	function obj:Set(v, silent)
		self.Value = v and true or false
		paint()
		if not silent then safe(o.Callback, self.Value) end
	end
	function obj:Get() return self.Value end
	function obj:Serialize() return self.Value end
	hit.MouseButton1Down:Connect(function() pressed = true paint() end)
	hit.MouseButton1Up:Connect(function() pressed = false paint() end)
	hit.MouseLeave:Connect(function() if pressed then pressed = false paint() end end)
	hit.MouseButton1Click:Connect(function() obj:Set(not obj.Value) end)
	Hooks[#Hooks + 1] = function() paint() end
	obj.Value = o.Default and true or false
	paint(true)
	if obj.Value then safe(o.Callback, true) end
	return reg(o, obj)
end

function Box:AddSlider(o)
	local c = self:_row(o, 84)
	local mn, mx, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local obj = {Type = "Slider", Value = mn}
	local vb = new("TextBox", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(0, 24), AutomaticSize = AX, Text = "",
		ClearTextOnFocus = false, TextSize = 12, FontFace = font(E.FontWeight.SemiBold), Parent = c.row})
	new("UISizeConstraint", {MinSize = Vector2.new(58, 24), MaxSize = Vector2.new(120, 24), Parent = vb})
	new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = vb})
	bind(vb, "BackgroundColor3", "Bg") bind(vb, "TextColor3", "Text") corner(vb, 12)
	local barh = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 2, Active = true, Parent = c.col})
	local track = new("Frame", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 0, 0, 17), Size = UDim2.new(1, 0, 0, 6), Parent = barh})
	bind(track, "BackgroundColor3", "Track") corner(track, 3)
	local fill = new("Frame", {Size = UDim2.fromScale(0, 1), Parent = track})
	bind(fill, "BackgroundColor3", "Accent") corner(fill, 3)
	local knob = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(1, .5), Size = UDim2.fromOffset(14, 14), Parent = fill})
	bind(knob, "BackgroundColor3", "Text") corner(knob, 7)
	local bub = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(0, 0, 0, 7), Size = UDim2.fromOffset(48, 20), Parent = barh})
	bind(bub, "BackgroundColor3", "Accent") corner(bub, 10)
	bub.BackgroundTransparency = 1
	local bl = label(bub, "", 11, "OnAccent", E.FontWeight.SemiBold)
	bl.Size, bl.TextXAlignment, bl.TextTransparency = UDim2.fromScale(1, 1), E.TextXAlignment.Center, 1
	local function showBub(on)
		tw(bub, {BackgroundTransparency = on and 0 or 1}, .1)
		tw(bl, {TextTransparency = on and 0 or 1}, .1)
		tw(knob, {Size = UDim2.fromOffset(on and 20 or 14, on and 20 or 14)}, .14)
	end
	-- instant = true dipakai saat digeser: langsung ikut jari tanpa tween, dan tidak jalan kalau nilainya sama
	function obj:Set(v, silent, instant)
		v = math.clamp(math.floor(((tonumber(v) or mn) - mn) / inc + .5) * inc + mn, mn, mx)
		v = math.floor(v * 10000 + .5) / 10000
		if instant and v == self.Value then return end
		self.Value = v
		local r = mx > mn and (v - mn) / (mx - mn) or 0
		local txt = tostring(math.floor(v * 100 + .5) / 100) .. (o.Suffix or "")
		vb.Text, bl.Text = txt, txt
		if instant then
			fill.Size = UDim2.fromScale(r, 1)
			bub.Position = UDim2.new(math.clamp(r, .1, .9), 0, 0, 7)
		else
			tw(fill, {Size = UDim2.fromScale(r, 1)}, .1)
			tw(bub, {Position = UDim2.new(math.clamp(r, .1, .9), 0, 0, 7)}, .1)
		end
		if not silent then safe(o.Callback, v) end
	end
	function obj:Get() return self.Value end
	function obj:Serialize() return self.Value end
	dragger(self.Win, barh, function(p)
		obj:Set(mn + (mx - mn) * math.clamp((p.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1), false, true)
	end, function() showBub(true) self:_lock(true) end, function() showBub(false) self:_lock(false) end)
	vb.FocusLost:Connect(function() obj:Set(tonumber(vb.Text:match("-?[%d%.]+")) or obj.Value) end)
	obj:Set(o.Default or mn, true)
	return reg(o, obj)
end

function Box:AddInput(o)
	local c = self:_row(o, 156)
	local obj = {Type = "Input", Value = o.Default or ""}
	local f = new("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(146, 28), Parent = c.row})
	bind(f, "BackgroundColor3", "Bg") corner(f, 14)
	local st = stroke(f, "Stroke", 1, 0)
	local tb = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Text = obj.Value,
		PlaceholderText = o.Placeholder or "ketik di sini", ClearTextOnFocus = false, TextSize = 12, FontFace = font(), TextXAlignment = E.TextXAlignment.Left, Parent = f})
	bind(tb, "TextColor3", "Text") bind(tb, "PlaceholderColor3", "Sub")
	tb.Focused:Connect(function() tw(st, {Color = Cur.Accent}, .1) end)
	tb.FocusLost:Connect(function(enter)
		tw(st, {Color = Cur.Stroke}, .14)
