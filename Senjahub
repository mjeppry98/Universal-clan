			if okp and type(pv) == "number" and pv > 0 then ping = "  " .. math.floor(pv * 1000 + .5) .. " ms" end
			fps.Text = math.floor(frames / acc + .5) .. " fps" .. ping
			acc, frames = 0, 0
		end
	end)
	-- kalau rbxthumb tidak termuat, coba lewat GetUserThumbnailAsync
	task.spawn(function()
		local t0 = os.clock()
		while av.Parent and not av.IsLoaded and os.clock() - t0 < 4 do task.wait(.25) end
		if av.Parent and not av.IsLoaded then
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(LP.UserId, E.ThumbnailType.HeadShot, E.ThumbnailSize.Size100x100)
			end)
			if ok and url then av.Image = url end
		end
	end)

	-- geser window lewat header
	top.InputBegan:Connect(function(i)
		if not isPtr(i) then return end
		local ds, sp = i.Position, root.Position
		win:_stop()
		ptrDrag(function(m)
			local d = (m.Position - ds) / scale.Scale
			win.Home = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
			root.Position = win.Home
		end, function()
			win:_clamp()
		end)
	end)

	-- garis di bawah window: tarik ke atas untuk menutup
	local grab = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, 1),
		Position = UDim2.new(.5, 0, 1, 0), Size = UDim2.fromOffset(220, 26), ZIndex = 20, Parent = main})
	local gp = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -7), Size = UDim2.fromOffset(34, 3), Parent = grab})
	bind(gp, "BackgroundColor3", "Sub") corner(gp, 2)
	gp.BackgroundTransparency = .55
	win.GrabFx = {pill = gp}
	grab.MouseEnter:Connect(function() tw(gp, {Size = UDim2.fromOffset(52, 3), BackgroundTransparency = .1}, .1) end)
	grab.MouseLeave:Connect(function() tw(gp, {Size = UDim2.fromOffset(34, 3), BackgroundTransparency = .55}, .12) end)
	win.Grab = grab
	swipeClose(win, grab)

	-- tombol bulat melayang: ketuk = buka/tutup UI, seret = pindah (menempel ke sisi layar saat dilepas). posisinya diingat.
	local fvp = workspace.CurrentCamera.ViewportSize
	local fx0p = math.clamp(type(P.fx) == "number" and P.fx or 36, 36, math.max(36, fvp.X - 36))
	local fy0p = math.clamp(type(P.fy) == "number" and P.fy or 100, 36, math.max(36, fvp.Y - 36))
	local fabRight = fx0p > fvp.X / 2
	local fab = new("TextButton", {Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(fx0p, fy0p),
		Size = UDim2.fromOffset(46, 46), ZIndex = 60, Parent = gui})
	bind(fab, "BackgroundColor3", "Bg") corner(fab, 23)
	local fst = stroke(fab, "Stroke", 1.5, 0)
	local fus = new("UIScale", {Parent = fab})
	local fic = img(fab, o.Icon or "logo", 22, "Accent")
	fic.AnchorPoint, fic.Position, fic.ZIndex = Vector2.new(.5, .5), UDim2.fromScale(.5, .5), 61
	local fics = new("UIScale", {Parent = fic})
	win.Fab, win.FabStroke, win.FabScale = fab, fst, fus
	local fd = false
	fab.MouseEnter:Connect(function() if not fd then tw(fus, {Scale = win.Open and .92 or 1.08}, .1) end end)
	fab.MouseLeave:Connect(function() if not fd then tw(fus, {Scale = win.Open and .86 or 1}, .12) end end)
	fab.InputBegan:Connect(function(i)
		if fd or not isPtr(i) then return end
		fd = true
		local moved, fx0, fp0 = false, i.Position, fab.Position
		tw(fus, {Scale = .9}, .06)
		ptrDrag(function(m)
			local d = m.Position - fx0
			if not moved and d.Magnitude > 6 then moved = true end
			if moved then fab.Position = UDim2.fromOffset(fp0.X.Offset + d.X, fp0.Y.Offset + d.Y) end
		end, function()
			fd = false
			tw(fus, {Scale = win.Open and .86 or 1}, .16)
			if not moved then
				win:Toggle()
				return
			end
			local v = workspace.CurrentCamera.ViewportSize
			local x, y = fab.Position.X.Offset, fab.Position.Y.Offset
			local nx, ny = x < v.X / 2 and 36 or v.X - 36, math.clamp(y, 36, v.Y - 36)
			fabRight = nx > v.X / 2
			tw(fab, {Position = UDim2.fromOffset(nx, ny)}, .26, Qn)
			if win.Live then pref("fx", nx) pref("fy", ny) end
		end)
	end)

	win:_c(UIS.InputBegan, function(i, gpd)
		if not gpd and i.KeyCode == win.ToggleKey then win:Toggle() end
	end)

	-- tiap 10 detik: ikon di header (saat UI terbuka) dan di tombol bulat (saat terlihat) bergerak bersamaan
	task.spawn(function()
		while gui.Parent do
			task.wait(10)
			if win.Open then breathe(logo, logos) end
			if fab.Visible then breathe(fic, fics) end
		end
	end)

	-- layar diputar / berubah ukuran: window dan tombol bulat ikut menyesuaikan
	win:_c(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), function()
		win:_fit()
		local v = workspace.CurrentCamera.ViewportSize
		fab.Position = UDim2.fromOffset(fabRight and v.X - 36 or 36, math.clamp(fab.Position.Y.Offset, 36, math.max(36, v.Y - 36)))
	end)
	-- simpan otomatis config (hanya aktif kalau "Muat & simpan otomatis" menyala dan Win:AutoLoad() sudah dipanggil)
	task.spawn(function()
		while gui.Parent do
			task.wait(15)
			win:_autoSave()
		end
	end)

	-- pengaturan tetap: halaman bawaan yang dibuka lewat tombol gerigi di header, bukan lewat bilah tab
	local st = win:_newPage()
	st.IsSettings, st.Index = true, 1e6
	st._paint = function(sel, inst)
		local t = inst and 0 or .12
		tw(win.GearBtn, {BackgroundTransparency = sel and 0 or 1}, t)
		tw(win.GearIc, {ImageColor3 = sel and Cur.Accent or Cur.Sub}, t)
	end
	Hooks[#Hooks + 1] = function() st._paint(win.Current == st, true) end
	win.Settings = st
	win:_buildSettings(st)
	-- tema / aksen yang berubah (dari mana pun) ikut tersimpan
	Senja:OnTheme(function()
		if not win.Live then return end
		pref("theme", CurName)
		pref("accent", AccentOverride and toHex(AccentOverride) or nil)
	end)
	win.Live = true

	table.insert(Senja.Windows, win)
	win:_fit()
	local _, cy = win:_px()
	win:_at(cy)
	win:Toggle(true)
	return win
end

function Senja:Destroy()
	for _, w in ipairs({table.unpack(self.Windows)}) do w:Destroy() end
	if notifConn then notifConn:Disconnect() notifConn = nil end
	notifActive = {}
	if notifHolder and notifHolder.Parent then notifHolder.Parent:Destroy() end
	notifHolder = nil
end

return Senja
