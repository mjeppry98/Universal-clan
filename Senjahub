		Size = UDim2.fromOffset(math.min(sz.X, vp.X - 24), math.min(sz.Y, vp.Y - 24)), Parent = gui})
	local scale = new("UIScale", {Scale = .94, Parent = root})
	local main = new("Frame", {Size = UDim2.fromScale(1, 1), ClipsDescendants = true, Parent = root})
	bind(main, "BackgroundColor3", "Bg") corner(main, 6) stroke(main, "Stroke", 1, 0)
	win.Gui, win.Root, win.Scale, win.Main, win.Dim = gui, root, scale, main, dim

	-- topbar
	local top = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = main})
	local logo = img(top, o.Icon or "logo", 18, "Accent")
	logo.AnchorPoint, logo.Position = Vector2.new(0, .5), UDim2.new(0, 12, .5, 0)
	local tl = new("Frame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(38, 0), Size = UDim2.new(0, 0, 1, 0), AutomaticSize = AX, Parent = top})
	new("UIListLayout", {FillDirection = E.FillDirection.Horizontal, VerticalAlignment = E.VerticalAlignment.Center, Padding = UDim.new(0, 8), Parent = tl})
	local t1 = label(tl, o.Title or "Senja", 14, "Text", E.FontWeight.SemiBold)
	t1.AutomaticSize, t1.Size = AX, UDim2.fromOffset(0, 18)
	local t2 = label(tl, o.Subtitle or ("v" .. Senja.Version), 11, "Sub")
	t2.AutomaticSize, t2.Size = AX, UDim2.fromOffset(0, 14)
	local tline = new("Frame", {Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1), Parent = top})
	bind(tline, "BackgroundColor3", "Stroke")

	local function wbtn(ic, x, fn)
		local b = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5),
			Position = UDim2.new(1, x, .5, 0), Size = UDim2.fromOffset(26, 26), Parent = top})
		local i = img(b, ic, 12, "Sub")
		i.AnchorPoint, i.Position = Vector2.new(.5, .5), UDim2.fromScale(.5, .5)
		b.MouseEnter:Connect(function() tw(i, {ImageColor3 = Cur.Text}, .1) end)
		b.MouseLeave:Connect(function() tw(i, {ImageColor3 = Cur.Sub}, .15) end)
		b.MouseButton1Click:Connect(fn)
	end
	wbtn("x", -8, function() win:_confirmClose() end)
	wbtn("minus", -34, function()
		win:Toggle(false)
		Senja:Notify({Title = "UI disembunyikan", Content = "geser ke bawah dari tepi atas layar, atau tekan " .. win.ToggleKey.Name, Duration = 3})
	end)

	local sbox = new("Frame", {AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -66, .5, 0), Size = UDim2.fromOffset(130, 22), Parent = top})
	bind(sbox, "BackgroundColor3", "Surface") corner(sbox, 3)
	local sst = stroke(sbox, "Stroke", 1, 0)
	local si = img(sbox, "search", 11, "Sub")
	si.AnchorPoint, si.Position = Vector2.new(0, .5), UDim2.new(0, 8, .5, 0)
	local sb = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.fromOffset(25, 0), Size = UDim2.new(1, -31, 1, 0), Text = "", PlaceholderText = "cari...",
		ClearTextOnFocus = false, TextSize = 12, FontFace = font(), TextXAlignment = E.TextXAlignment.Left, Parent = sbox})
	bind(sb, "TextColor3", "Text") bind(sb, "PlaceholderColor3", "Sub")
	sb.Focused:Connect(function() tw(sst, {Color = Cur.Accent}, .1) tw(si, {ImageColor3 = Cur.Accent}, .1) end)
	sb.FocusLost:Connect(function() tw(sst, {Color = Cur.Stroke}, .15) tw(si, {ImageColor3 = Cur.Sub}, .15) end)
	sb:GetPropertyChangedSignal("Text"):Connect(function() win:_filter(sb.Text) end)
	win.SearchBox = sb

	-- sidebar
	local side = new("Frame", {Position = UDim2.fromOffset(0, 38), Size = UDim2.new(0, 132, 1, -38), Parent = main})
	bind(side, "BackgroundColor3", "Side")
	local sline = new("Frame", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 1, 1, 0), Parent = side})
	bind(sline, "BackgroundColor3", "Stroke")
	local FOOT = 54
	local tabs = new("ScrollingFrame", {BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 1, -(FOOT + 14)),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = AY, ScrollBarThickness = 0, Parent = side})
	new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = E.SortOrder.LayoutOrder, Parent = tabs})
	pad(tabs, 8, 0, 8, 0)
	win.TabList = tabs

	-- profil pemain di bawah sidebar
	local foot = new("Frame", {BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -FOOT), Size = UDim2.new(1, 0, 0, FOOT), Parent = side})
	local fline = new("Frame", {Size = UDim2.new(1, 0, 0, 1), Parent = foot})
	bind(fline, "BackgroundColor3", "Stroke")
	local av = new("ImageLabel", {AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 12, .5, 1), Size = UDim2.fromOffset(32, 32),
		Image = "rbxthumb://type=AvatarHeadShot&id=" .. LP.UserId .. "&w=150&h=150", Parent = foot})
	bind(av, "BackgroundColor3", "Hover") corner(av, 16) stroke(av, "Stroke", 1, 0)
	local dn = label(foot, LP.DisplayName, 12, "Text", E.FontWeight.SemiBold)
	dn.Position, dn.Size, dn.TextTruncate = UDim2.fromOffset(52, 13), UDim2.new(1, -60, 0, 15), E.TextTruncate.AtEnd
	local un = label(foot, "@" .. LP.Name, 10, "Sub")
	un.Position, un.Size, un.TextTruncate = UDim2.fromOffset(52, 29), UDim2.new(1, -60, 0, 12), E.TextTruncate.AtEnd
	-- kalau rbxthumb tidak termuat, coba lewat GetUserThumbnailAsync
	task.spawn(function()
		local t0 = os.clock()
		while av.Parent and not av.IsLoaded and os.clock() - t0 < 4 do task.wait(.25) end
		if av.Parent and not av.IsLoaded then
			local ok, url = pcall(function()
				return Players:GetUserThumbnailAsync(LP.UserId, E.ThumbnailType.HeadShot, E.ThumbnailSize.Size100x100)
			end)
			if ok and url then av.Image = url end
		end
	end)

	win.Pages = new("Frame", {BackgroundTransparency = 1, ClipsDescendants = true, Position = UDim2.new(0, 132, 0, 38), Size = UDim2.new(1, -132, 1, -38), Parent = main})

	-- drag window lewat topbar
	local dragging, ds, sp = false, nil, nil
	top.InputBegan:Connect(function(i)
		if i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch then
			dragging, ds, sp = true, i.Position, root.Position
			win:_stop()
		end
	end)
	win:_c(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == E.UserInputType.MouseMovement or i.UserInputType == E.UserInputType.Touch) then
			local d = (i.Position - ds) / scale.Scale
			win.Home = UDim2.new(sp.X.Scale, sp.X.Offset + d.X, sp.Y.Scale, sp.Y.Offset + d.Y)
			root.Position = win.Home
		end
	end)
	win:_c(UIS.InputEnded, function(i)
		if i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch then dragging = false end
	end)

	-- gagang di tepi atas layar (muncul saat UI tertutup): tarik ke bawah untuk membuka
	local HW, HB = 112, 44
	local handle = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, 0),
		Position = UDim2.new(.5, 0, 0, 0), Size = UDim2.fromOffset(320, 84), ZIndex = 50, Visible = false, Parent = gui})
	local pill = new("Frame", {AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, HB), Size = UDim2.fromOffset(HW, 5),
		BackgroundColor3 = WHITE, BackgroundTransparency = .3, Parent = handle})
	corner(pill, 3) new("UIStroke", {Color = BLACK, Transparency = .6, Thickness = 1, Parent = pill})
	local hint = new("TextLabel", {BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, HB + 16),
		Size = UDim2.fromOffset(220, 14), Text = "Tarik ke bawah", TextSize = 11, FontFace = font(E.FontWeight.SemiBold), TextColor3 = WHITE,
		TextTransparency = 1, TextStrokeColor3 = BLACK, TextStrokeTransparency = 1, Parent = handle})
	local fx = {pill = pill, hint = hint, base = HB, w = HW, over = false, hover = false, tweens = {}}
	win.Handle, win.HandleFx = handle, fx
	handle.MouseEnter:Connect(function()
		fx.hover = true
		if win.Pulling then return end
		fxTw(fx, pill, {Size = UDim2.fromOffset(HW + 36, 5), BackgroundTransparency = .05}, .12)
		fxTw(fx, hint, {TextTransparency = 0, TextStrokeTransparency = .75}, .12)
	end)
	handle.MouseLeave:Connect(function()
		fx.hover = false
		if win.Pulling then return end
		fxTw(fx, pill, {Size = UDim2.fromOffset(HW, 5), BackgroundTransparency = .3}, .15)
		fxTw(fx, hint, {TextTransparency = 1, TextStrokeTransparency = 1}, .15)
	end)
	-- napas pelan supaya gagang mudah ditemukan
	task.spawn(function()
		local down = false
		while handle.Parent do
			if handle.Visible and not win.Pulling then
				down = not down
				fxTw(fx, pill, {Position = UDim2.new(.5, 0, 0, HB + (down and 6 or 0))}, .9, Sine)
				task.wait(.9)
			else
				task.wait(.3)
			end
		end
	end)

	-- garis di bawah window: tarik ke atas untuk menutup
	local grab = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, 1),
		Position = UDim2.new(.5, 0, 1, 0), Size = UDim2.fromOffset(220, 26), ZIndex = 20, Parent = main})
	local gp = new("Frame", {AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -7), Size = UDim2.fromOffset(34, 3), Parent = grab})
	bind(gp, "BackgroundColor3", "Sub") corner(gp, 2)
	gp.BackgroundTransparency = .55
	win.GrabFx = {pill = gp}
	grab.MouseEnter:Connect(function() tw(gp, {Size = UDim2.fromOffset(52, 3), BackgroundTransparency = .1}, .12) end)
	grab.MouseLeave:Connect(function() tw(gp, {Size = UDim2.fromOffset(34, 3), BackgroundTransparency = .55}, .15) end)

	swipe(win, handle, true)
	swipe(win, grab, false)

	win:_c(UIS.InputBegan, function(i, gpd)
		if not gpd and i.KeyCode == win.ToggleKey then win:Toggle() end
	end)

	table.insert(Senja.Windows, win)
	local _, cy = win:_px()
	win:_at(cy)
	win:Toggle(true)
	return win
end

function Senja:Destroy()
	for _, w in ipairs({table.unpack(self.Windows)}) do w:Destroy() end
end

return Senja
