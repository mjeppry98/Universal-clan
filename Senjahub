		Stroke = C3(30, 30, 30), Text = C3(242, 242, 242), Sub = C3(128, 128, 128), Accent = acc, OnAccent = on or C3(0, 0, 0)}
end
local Themes = {
	Hitam  = mk(C3(240, 240, 240)),
	Jingga = mk(C3(255, 138, 61)),
	Biru   = mk(C3(76, 148, 255)),
	Hijau  = mk(C3(72, 214, 128)),
	Ungu   = mk(C3(164, 124, 255)),
	Merah  = mk(C3(255, 84, 92), C3(20, 0, 2)),
	Mawar  = mk(C3(255, 104, 164)),
