local Window = {}
Window.__index = Window

-- rail tab di kiri: lebar rail, tinggi satu tombol tab, jarak antar tombol
local RAIL, TABH, TABP, SUBH = 72, 50, 4, 32
-- transparansi kartu saat latar beranimasi menyala (supaya latarnya terlihat samar di balik kartu)
local CARDT = .18

function Window:_c(sig, fn)
	local c = sig:Connect(fn)
	self.Conns[#self.Conns + 1] = c
	return c
end

-- posisi Y (piksel) saat terbuka dan saat tersembunyi di atas layar
function Window:_px()
	local hy = self.Home.Y.Scale * workspace.CurrentCamera.ViewportSize.Y + self.Home.Y.Offset
	local cy = -(self.Root.Size.Y.Offset * self.UserScale) / 2 - 24
	return hy, cy
end
function Window:_at(y)
	self.Root.Position = UDim2.new(self.Home.X.Scale, self.Home.X.Offset, 0, y)
end
function Window:_stop()
	for _, t in ipairs(self._tws) do t:Cancel() end
	self._tws = {}
end
-- p: 0 = tertutup, 1 = terbuka penuh. dipakai saat window ditarik ke atas untuk menutup
function Window:_progress(p)
	local hy, cy = self:_px()
	self:_at(cy + (hy - cy) * p)
	self.Dim.BackgroundTransparency = 1 - (1 - self:_dimT()) * p
end
-- hanya posisi dan redup latar yang dianimasikan (tanpa skala / pudar), jadi isi window tidak digambar ulang tiap frame
function Window:_go(open)
	self:_stop()
	local _, cy = self:_px()
	local dur = open and .3 or .2
	self._tws = {
		tw(self.Root, {Position = open and self.Home or UDim2.new(self.Home.X.Scale, self.Home.X.Offset, 0, cy)}, dur, Qn),
		tw(self.Dim, {BackgroundTransparency = open and self:_dimT() or 1}, dur, Q),
	}
end

-- tombol melayang ikut berubah mengikuti status buka/tutup
function Window:_fab()
	if not self.Fab then return end
	local op = self.Open
	tw(self.FabScale, {Scale = op and .86 or 1}, .16)
	tw(self.FabStroke, {Color = op and Cur.Accent or Cur.Stroke}, .14)
	tw(self.Fab, {BackgroundTransparency = op and .3 or 0}, .14)
end
-- saat UI tertutup tombol selalu tampil, supaya UI tidak bisa "hilang" tanpa jalan kembali
function Window:_fabVis()
	if self.Fab then self.Fab.Visible = self.FabWanted or not self.Open end
end
function Window:SetFab(on)
	self.FabWanted = on and true or false
	self:_fabVis()
end

-- garis bawah window saat ditarik ke atas
function Window:_grabFx(over)
	local g = self.GrabFx.pill
	tw(g, {BackgroundColor3 = over and Cur.Accent or Cur.Sub, BackgroundTransparency = over and 0 or .55, Size = UDim2.fromOffset(over and 64 or 34, 3)}, .1)
end

function Window:Toggle(v)
	if v == nil then v = not self.Open end
	self.Open = v
	self._tok += 1
	local tok = self._tok
	self:_fab()
	self:_fabVis()
	if v then
		self.Root.Visible, self.Dim.Visible = true, true
		self:_go(true)
		self:_fxSync()
	else
		self:_go(false)
		local first = self._tws[1]
		first.Completed:Connect(function()
			if self._tok == tok and not self.Open then
				self.Root.Visible, self.Dim.Visible = false, false
				self:_fxSync()
			end
		end)
	end
end

function Window:SetScale(n)
	self.UserScale = n
	tw(self.Scale, {Scale = n}, .15)
	self:_fit()
end

-- saat diminimalkan latar tidak diredupkan, supaya game tetap terlihat
function Window:_dimT() return self.Minimized and 1 or self.DimT end

function Window:SetDim(on)
