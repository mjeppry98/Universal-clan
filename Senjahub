function Window:Dialog(o)
	-- dialog harus terlihat: pulihkan dari minimize / buka window dulu
	if self.Minimized then
		self:SetMinimized(false)
		task.delay(.22, function() self:Dialog(o) end)
		return
	end
	if not self.Open then self:Toggle(true) end
	local ov = new("TextButton", {AutoButtonColor = false, Text = "", BackgroundColor3 = BLACK, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 100, Parent = self.Main})
	corner(ov, 20)
	tw(ov, {BackgroundTransparency = .4}, .12)
	local card = new("Frame", {AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(math.clamp(self.Root.Size.X.Offset - 32, 200, 320), 0), AutomaticSize = AY, Parent = ov})
	bind(card, "BackgroundColor3", "Surface") corner(card, 20) stroke(card, "Stroke", 1, 0) pad(card, 20, 20, 20, 16)
	local us = new("UIScale", {Scale = .94, Parent = card})
	tw(us, {Scale = 1}, .2, Qn)
	new("UIListLayout", {Padding = UDim.new(0, 8), SortOrder = E.SortOrder.LayoutOrder, Parent = card})
