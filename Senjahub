	function obj:Get() return self.Value end
	function obj:Serialize() return self.Value end
	return reg(o, obj)
end

function Box:AddDropdown(o)
	local c = self:_row(o, 146)
	local multi = o.Multi
	local obj = {Type = "Dropdown", Values = o.Values or {}, Value = multi and {} or nil, Open = false}
	local disp = new("TextButton", {AutoButtonColor = false, Text = "", AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, 0, .5, 0), Size = UDim2.fromOffset(136, 28), Parent = c.row})
	bind(disp, "BackgroundColor3", "Bg") corner(disp, 14)
	local dst = stroke(disp, "Stroke", 1, 0)
	local dl = label(disp, "", 12, "Text")
	dl.Position, dl.Size, dl.TextTruncate = UDim2.fromOffset(12, 0), UDim2.new(1, -32, 1, 0), E.TextTruncate.AtEnd
	local arrow = img(disp, "chevron", 11, "Sub")
	arrow.AnchorPoint, arrow.Position = Vector2.new(1, .5), UDim2.new(1, -10, .5, 0)
	local body = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), ClipsDescendants = true, LayoutOrder = 2, Parent = c.col})
	pad(body, 0, 10, 0, 0)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = E.SortOrder.LayoutOrder, Parent = body})
	local sb
	if o.Search then
		local sf = new("Frame", {Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1, Parent = body})
		bind(sf, "BackgroundColor3", "Bg") corner(sf, 14)
		sb = new("TextBox", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0), Text = "", PlaceholderText = "cari...",
			ClearTextOnFocus = false, TextSize = 12, FontFace = font(), TextXAlignment = E.TextXAlignment.Left, Parent = sf})
		bind(sb, "TextColor3", "Text") bind(sb, "PlaceholderColor3", "Sub")
	end
	local list = new("ScrollingFrame", {BackgroundTransparency = 1, LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), ScrollBarThickness = 2,
		AutomaticCanvasSize = AY, CanvasSize = UDim2.new(), Parent = body})
	new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = E.SortOrder.LayoutOrder, Parent = list})
	local opts = {}
	local function target() return 10 + (sb and 34 or 0) + list.Size.Y.Offset end
	local function isSel(v) if multi then return table.find(obj.Value, v) ~= nil end return obj.Value == v end
	local function paint()
		for v, b in pairs(opts) do
			local s = isSel(v)
			tw(b.lbl, {TextColor3 = s and Cur.Accent or Cur.Text}, .08)
			tw(b.chk, {ImageTransparency = s and 0 or 1}, .08)
		end
		local ph = o.Placeholder or "pilih..."
		if multi then dl.Text = #obj.Value > 0 and table.concat(obj.Value, ", ") or ph else dl.Text = obj.Value or ph end
	end
	local function build()
		for _, b in pairs(opts) do b.btn:Destroy() end
		opts = {}
		for i, v in ipairs(obj.Values) do
			v = tostring(v)
			local b = new("TextButton", {AutoButtonColor = false, Text = "", BackgroundTransparency = 1, Size = UDim2.new(1, -4, 0, 28), LayoutOrder = i, Parent = list})
			bind(b, "BackgroundColor3", "Hover") corner(b, 10)
			local l = label(b, v, 12, "Text")
			l.Position, l.Size = UDim2.fromOffset(12, 0), UDim2.new(1, -36, 1, 0)
			local ck = img(b, "check", 11, "Accent")
			ck.AnchorPoint, ck.Position, ck.ImageTransparency = Vector2.new(1, .5), UDim2.new(1, -10, .5, 0), 1
			b.MouseEnter:Connect(function() tw(b, {BackgroundTransparency = 0}, .06) end)
			b.MouseLeave:Connect(function() tw(b, {BackgroundTransparency = 1}, .1) end)
			b.MouseButton1Click:Connect(function() obj:_pick(v) end)
			opts[v] = {btn = b, lbl = l, chk = ck}
		end
		list.Size = UDim2.new(1, 0, 0, math.min(#obj.Values * 30, 138))
		paint()
		if obj.Open then tw(body, {Size = UDim2.new(1, 0, 0, target())}, .18) end
	end
	local function setOpen(v)
		obj.Open = v
		if v then
			if openDD and openDD ~= obj then openDD:Close() end
			openDD = obj
		elseif openDD == obj then
			openDD = nil
		end
		tw(body, {Size = UDim2.new(1, 0, 0, v and target() or 0)}, .2)
		tw(arrow, {Rotation = v and 180 or 0}, .18)
		tw(dst, {Color = v and Cur.Accent or Cur.Stroke}, .1)
	end
	disp.MouseButton1Click:Connect(function() setOpen(not obj.Open) end)
	if sb then
		sb:GetPropertyChangedSignal("Text"):Connect(function()
			local q = sb.Text:lower()
			for v, b in pairs(opts) do b.btn.Visible = q == "" or v:lower():find(q, 1, true) ~= nil end
		end)
	end
	function obj:Set(v, silent)
		if multi then
			self.Value = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do table.insert(self.Value, tostring(x)) end
		else self.Value = v ~= nil and tostring(v) or nil end
		paint()
		if not silent then safe(o.Callback, self.Value) end
	end
	function obj:_pick(v)
		if multi then
			local i = table.find(self.Value, v)
			if i then table.remove(self.Value, i) else table.insert(self.Value, v) end
			paint() safe(o.Callback, self.Value)
		else
			self:Set(v)
			task.delay(.06, function() setOpen(false) end)
		end
	end
	function obj:Get() return self.Value end
	function obj:Serialize() return self.Value end
	function obj:Close() if self.Open then setOpen(false) end end
	function obj:Refresh(vals)
		self.Values = vals
		if not multi and self.Value and not table.find(vals, self.Value) then self.Value = nil end
		build()
	end
	Hooks[#Hooks + 1] = function() paint() end
	build()
	if o.Default ~= nil then obj:Set(o.Default, true) end
	return reg(o, obj)
end

