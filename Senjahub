-- gestur geser vertikal. opening = true: tarik dari tepi atas layar untuk membuka;
-- opening = false: tarik ke atas dari garis bawah window untuk menutup.
-- window ikut jari/kursor (bergeser, membesar, latar meredup). lepas setelah cukup jauh atau cukup cepat -> selesai, kalau tidak -> kembali.
local function swipe(win, zone, opening)
	local on, y0, last, lt, vel, over = false, 0, 0, 0, 0, false
	local function isPtr(i) return i.UserInputType == E.UserInputType.MouseButton1 or i.UserInputType == E.UserInputType.Touch end
	local function span() return math.clamp(workspace.CurrentCamera.ViewportSize.Y * .45, 200, 380) end
	zone.InputBegan:Connect(function(i)
		if not isPtr(i) or on then return end
		on, y0, last, lt, vel, over = true, i.Position.Y, i.Position.Y, os.clock(), 0, false
		win._tok += 1
		win:_stop()
		if opening then
			win.Root.Visible, win.Dim.Visible = true, true
			win:_progress(0)
		end
	end)
	win:_c(UIS.InputChanged, function(i)
		if not on then return end
		if i.UserInputType ~= E.UserInputType.MouseMovement and i.UserInputType ~= E.UserInputType.Touch then return end
		local y, now = i.Position.Y, os.clock()
		vel = vel * .6 + ((y - last) / math.max(now - lt, .001)) * .4
		last, lt = y, now
		local dy = y - y0
		local p = opening and math.clamp(dy / span(), 0, 1) or 1 - math.clamp(-dy / span(), 0, 1)
		win:_progress(p)
		local nowOver = opening and p > .35 or (not opening and p < .65)
		if opening then win:_pull(p, nowOver) elseif nowOver ~= over then win:_grabFx(nowOver) end
		over = nowOver
	end)
	win:_c(UIS.InputEnded, function(i)
		if not on or not isPtr(i) then return end
		on = false
		local dy = last - y0
		if opening then
			win:Toggle(over or vel > 900 or math.abs(dy) < 4)
		else
			win:_grabFx(false)
			win:Toggle(not (over or vel < -900))
		end
	end)
end

function Senja:CreateWindow(o)
	o = o or {}
	if o.Theme then self:SetTheme(o.Theme) end
	local win = setmetatable({Tabs = {}, Conns = {}, Open = false, UserScale = 1, ToggleKey = o.ToggleKey or E.KeyCode.RightShift,
		Home = UDim2.fromScale(.5, .5), _tok = 0, _tws = {}, DimT = .62, Pulling = false}, Window)
	local gui = new("ScreenGui", {Name = o.Name or "SenjaUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = E.ZIndexBehavior.Sibling})
	mount(gui)
	local dim = new("Frame", {BackgroundColor3 = BLACK, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui})
	local vp = workspace.CurrentCamera.ViewportSize
	local sz = o.Size or Vector2.new(620, 410)
