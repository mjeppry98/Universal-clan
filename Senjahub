function Window:_confirmClose()
	local function ask()
		self:Dialog({Title = "Tutup UI?", Content = "Window akan dihapus. Pengaturan UI tetap tersimpan, config fitur yang belum disimpan hilang.",
			Buttons = {{Title = "Batal"}, {Title = "Tutup", Primary = true, Callback = function() self:Destroy() end}}})
	end
	-- dialog tidak terlihat saat window diminimalkan, jadi dipulihkan dulu
	if self.Minimized then
		self:SetMinimized(false)
		task.delay(.2, ask)
	else
