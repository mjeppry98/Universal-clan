-- setiap elemen berupa kartu bulat sendiri (tanpa garis tepi), jarak antar kartu kecil.
-- section hanya judul kecil yang bisa dilipat; kartu di dalamnya ikut terlipat.
-- kartu / panel yang dibuat sedikit tembus pandang saat latar beranimasi menyala
local Cards = {}
local function glass(o)
	Cards[#Cards + 1] = o
	o.BackgroundTransparency = Senja._cardT or 0
	return o
end

local Box = {}
Box.__index = Box
local function newBox(win, tab, body) return setmetatable({Win = win, Tab = tab, Body = body, _cnt = 0}, Box) end
function Box:_n() self._cnt += 1 return self._cnt end
-- matikan scroll halaman selama slider / color picker digeser (kalau tidak, halaman ikut tergulir di layar sentuh)
function Box:_lock(on)
	local s = self.Tab and self.Tab.Scroll
	if s then s.ScrollingEnabled = not on end
end
local lastRow
local openDD
-- metode umum untuk semua elemen: SetTitle, SetDescription, SetVisible, SetEnabled, Destroy
local function deco(obj, c)
	if not c then return obj end
	local win, item = c.owner.Win, c.item
	obj.Holder = c.h
	if not obj.SetTitle then
		function obj:SetTitle(t)
			c.title.Text = tostring(t)
			item.title = tostring(t)
		end
	end
	function obj:SetDescription(t)
		t = t and tostring(t) or ""
		item.desc = t
		if c.desc then
			c.desc.Text = t
			c.desc.Visible = t ~= ""
		elseif t ~= "" then
			local d = label(c.box, t, 11, "Sub")
			d.TextWrapped, d.AutomaticSize, d.Size = true, AY, UDim2.new(1, 0, 0, 0)
			c.desc = d
		end
	end
	function obj:SetVisible(v)
		item.hidden = not v
		if win:_page(win.Current) == c.owner.Tab then win:_filter(win.SearchBox.Text) else c.h.Visible = v and true or false end
	end
	local blk
	function obj:SetEnabled(v)
		v = v ~= false
		if not blk then
			if v then return end
			blk = new("TextButton", {Text = "", AutoButtonColor = false, BackgroundTransparency = .4, Position = UDim2.fromOffset(-15, -12),
				Size = UDim2.new(1, 30, 1, 24), ZIndex = 30, Parent = c.h})
			bind(blk, "BackgroundColor3", "Surface")
			corner(blk, 14)
		end
		blk.Visible = not v
	end
	function obj:Destroy()
		local items = c.owner.Tab.Items
		local i = table.find(items, item)
		if i then table.remove(items, i) end
		if c.flag and Senja.Flags[c.flag] == obj then Senja.Flags[c.flag] = nil end
		c.h:Destroy()
	end
	return obj
end
local function reg(o, obj)
	if o.Flag then
		Senja.Flags[o.Flag] = obj
		if lastRow then lastRow.flag = o.Flag end
	end
	return deco(obj, lastRow)
end

function Box:_row(o, cw, wantHit)
	local n = self:_n()
	local h = new("Frame", {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = n, Parent = self.Body})
	bind(h, "BackgroundColor3", "Surface") corner(h, 14) pad(h, 15, 12, 15, 12) glass(h)
	local us = new("UIScale", {Parent = h})
	local col = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, Parent = h})
	new("UIListLayout", {SortOrder = E.SortOrder.LayoutOrder, Parent = col})
	local row = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = AY, LayoutOrder = 1, Parent = col})
	local box = new("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -(cw or 0) - 12, 0, 0), AutomaticSize = AY, Parent = row})
	new("UIListLayout", {Padding = UDim.new(0, 2), Parent = box})
	local t = label(box, o.Title or "", 13, "Text")
	local d
	if o.Description and o.Description ~= "" then
		d = label(box, o.Description, 11, "Sub")
		d.TextWrapped, d.AutomaticSize, d.Size = true, AY, UDim2.new(1, 0, 0, 0)
	end
	local item = {holder = h, title = o.Title or "", desc = o.Description, box = self, hidden = false}
	table.insert(self.Tab.Items, item)
	local c = {h = h, row = row, box = box, col = col, title = t, desc = d, us = us, item = item, owner = self}
	lastRow = c
	return c
end

function Box:AddLabel(o)
	if type(o) == "string" then o = {Title = o} end
	local c = self:_row(o, 0)
	return deco({}, c)
end
Box.AddParagraph = Box.AddLabel

